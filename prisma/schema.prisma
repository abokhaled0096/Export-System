  actualLogisticsCosts ActualLogisticsCost[]
  freightQuotes        FreightQuote[]
  supplierQuotes       SupplierQuote[]
  purchaseOrders       PurchaseOrder[]
  journalLines         JournalLine[]
  payments             Payment[]

  @@index([orgId])
}

enum ApprovalOperator {
  GT
  GTE
  LT
  LTE
  EQ
}

/// قابلة للتعديل من الإعدادات بلا كود لاحقًا — v1 بتتزرع يدويًا (قاعدة CostItem/policy إدارية مؤجَّلة).
model ApprovalPolicy {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String           @db.Uuid
  subjectType      String
  conditionField   String
  operator         ApprovalOperator
  thresholdValue   Decimal          @db.Decimal(14, 4)
  requiredRoleId   String           @db.Uuid
  escalationRoleId String?          @db.Uuid
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())

  organization        Organization         @relation(fields: [orgId], references: [id])
  requiredRole        Role                 @relation("ApprovalPolicyRequiredRole", fields: [requiredRoleId], references: [id])
  approvals           Approval[]
  workflowDefinitions WorkflowDefinition[]

  @@index([orgId])
}

enum ApprovalDecision {
  Pending
  Approved
  Rejected
  Escalated
}

/// موافقة استثنائية موثّقة — الاستخدام الأول: تجاوز walkAwayPrice على Quote (Trigger على مستوى القاعدة
/// بيتحقق من وجود صف هنا بحالة Approved قبل ما يسمح بسعر تحت الحد الأدنى، راجع migration الـRLS).
model Approval {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId       String           @db.Uuid
  subjectType String
  subjectId   String           @db.Uuid
  policyId    String?          @db.Uuid
  requestedBy String           @db.Uuid
  decidedBy   String?          @db.Uuid
  decision    ApprovalDecision @default(Pending)
  reason      String?
  /// بيانات الكيان المطلوب إنشاؤه بعد الموافقة — subjectId محجوز مقدّمًا (uuidv7())، لكن الصف
  /// الفعلي (زي Quote) مينفعش يتعمل قبل الموافقة (الـTrigger بيمنعه)، فبنخزّن بياناته هنا مؤقتًا.
  payload     Json?
  decidedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())

  organization      Organization       @relation(fields: [orgId], references: [id])
  policy            ApprovalPolicy?    @relation(fields: [policyId], references: [id])
  requestedByUser   User               @relation("ApprovalRequestedBy", fields: [requestedBy], references: [id])
  decidedByUser     User?              @relation("ApprovalDecidedBy", fields: [decidedBy], references: [id])
  quotes            Quote[]
  gates             Gate[]
  purchaseOrders    PurchaseOrder[]
  documents         Document[]
  documentVersions  DocumentVersion[]
  negotiationRounds NegotiationRound[]

  @@index([orgId])
  @@index([subjectType, subjectId])
}

enum DealObjective {
  MaximizeProfit
  NewMarketEntry
  WinCustomer
  ProtectAccount
  ClearInventory
  TestMarket
}

enum DealStatus {
  Draft
  Pricing
  Negotiation
  Approved
  Won
  Lost
  Cancelled
}

/// الهوية التجارية الثابتة للصفقة — كل الأرقام في DealScenario (فصل مقصود، ERD v2 §5).
model Deal {
  id               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String        @db.Uuid
  opportunityId    String        @db.Uuid
  productId        String        @db.Uuid
  marketId         String        @db.Uuid
  customerId       String        @db.Uuid
  dealObjective    DealObjective
  status           DealStatus    @default(Draft)
  activeScenarioId String?       @db.Uuid
  lostReason       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  organization      Organization      @relation(fields: [orgId], references: [id])
  opportunity       Opportunity       @relation(fields: [opportunityId], references: [id])
  product           Product           @relation(fields: [productId], references: [id])
  market            Market            @relation(fields: [marketId], references: [id])
  customer          Company           @relation(fields: [customerId], references: [id])
  scenarios         DealScenario[]    @relation("DealScenarios")
  quotes            Quote[]
  salesOrders       SalesOrder[]
  complianceCases   ComplianceCase[]
  originProofs      OriginProof[]
  lcRequirements    LCRequirement[]
  shipments         Shipment[]
  sourcingRequests  SourcingRequest[]
  inventories       Inventory[]
  documents         Document[]
  documentPackages  DocumentPackage[]
  negotiations      Negotiation[]
  commissionEntries CommissionEntry[]
  journalLines      JournalLine[]
  invoices          Invoice[]

  @@index([orgId])
  @@index([opportunityId])
}

enum Incoterm {
  EXW
  FCA
  FAS
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
}

/// كل الأرقام هنا — مقارنة السيناريوهات هي الميزة الأساسية لوحدة 2 (ERD v2 §5).
/// ⚠️ v1: quantitySaleable/expectedProfit/expectedMarginPct/expectedMarkupPct أعمدة عادية
/// محسوبة في الـServer Action وقت الحفظ (مش DB Generated Column لسه — PG17.6، راجع docs/SCOPE-P2.md).
model DealScenario {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId             String   @db.Uuid
  dealId            String   @db.Uuid
  version           Int
  scenarioName      String
  quantityRaw       Decimal  @db.Decimal(14, 3)
  yieldRate         Decimal? @db.Decimal(5, 4)
  quantitySaleable  Decimal  @db.Decimal(14, 3)
  incoterm          Incoterm
  namedPlace        String?
  paymentTerms      String?
  advanceRatePct    Decimal? @db.Decimal(5, 2)
  creditDays        Int?
  currency          String   @db.Char(3)
  fxRateId          String   @db.Uuid
  breakEvenPrice    Decimal? @db.Decimal(14, 4)
  walkAwayPrice     Decimal  @db.Decimal(14, 4)
  targetPrice       Decimal? @db.Decimal(14, 4)
  openingPrice      Decimal? @db.Decimal(14, 4)
  finalPrice        Decimal? @db.Decimal(14, 4)
  expectedProfit    Decimal? @db.Decimal(14, 2)
  expectedMarginPct Decimal? @db.Decimal(5, 2)
  expectedMarkupPct Decimal? @db.Decimal(5, 2)
  financeCost       Decimal? @db.Decimal(14, 2)
  riskReserve       Decimal? @db.Decimal(14, 2)
  isLocked          Boolean  @default(false)
  /// Optimistic Locking — بيتزوّد في كل كتابة (مش نفس `version` الفوق اللي هو رقم نسخة تجارية
  /// زي Current/BestCase). الفورمات اللي بتعدّل حقل مباشر (finalPrice/isLocked) بتبعت القيمة
  /// اللي شافتها وقت تحميل الصفحة كـhidden field، ولو اتغيّرت في القاعدة من ساعتها، الكتابة
  /// بترفض برسالة واضحة بدل "آخر واحد يحفظ بيكسب من غير تحذير". راجع STATUS.md § Optimistic Locking.
  lockVersion       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  deal            Deal             @relation("DealScenarios", fields: [dealId], references: [id])
  fxRate          ExchangeRate     @relation(fields: [fxRateId], references: [id])
  costItems       CostItem[]
  riskItems       RiskItem[]
  quotes          Quote[]
  complianceCases ComplianceCase[]

  @@unique([dealId, version])
  @@index([orgId])
  @@index([dealId])
}

enum CostCategory {
  Product
  Processing
  Packaging
  Quality
  ExportLogistics
  InternationalFreight
  DestinationCharges
  SellingAdmin
  Finance
  RiskReserve
}

enum CostConfidenceLevel {
  Contract100
  OfficialQuote90
  ExpiringQuote75
  HistoricalAvg60
  InternalEstimate40
  Assumption20
}

model CostItem {
  id              String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId           String              @db.Uuid
  scenarioId      String              @db.Uuid
  category        CostCategory
  subcategory     String?
  amount          Decimal             @db.Decimal(14, 2)
  /// عملة البند نفسه — مش لازم تبقى نفس عملة السيناريو (زي تكلفة محلية بالجنيه المصري في
  /// سيناريو بالدولار). لو مختلفة، fxRateId لازم يبقى موجود عشان recomputeScenario() يقدر
  /// يحوّلها. راجع STATUS.md § آلية سعر الصرف.
  currency        String              @db.Char(3)
  fxRateId        String?             @db.Uuid
  confidenceLevel CostConfidenceLevel
  expiryDate      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  scenario DealScenario  @relation(fields: [scenarioId], references: [id])
  fxRate   ExchangeRate? @relation(fields: [fxRateId], references: [id])

  @@index([orgId])
  @@index([scenarioId])
}

enum RiskType {
  FX
  Freight
  Supplier
  Quality
  Credit
  Compliance
  Weather
  Political
}

/// شريحة ثالثة من P2 (27-28 أغسطس، ERD §5). ⚠️ v1: expectedCost محسوب في الـServer Action وقت
/// الحفظ (مش DB Generated Column — نفس قيد PG17.6 الموثّق في docs/SCOPE-P2.md §4.1).
model RiskItem {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId           String   @db.Uuid
  scenarioId      String   @db.Uuid
  riskType        RiskType
  probability     Decimal  @db.Decimal(3, 2) // 0.00–1.00
  financialImpact Decimal  @db.Decimal(14, 2)
  expectedCost    Decimal  @db.Decimal(14, 2) // = probability × financialImpact
  mitigation      String?
  residualRisk    Decimal? @db.Decimal(14, 2) // بعد التخفيف — إدخال يدوي في v1
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  scenario DealScenario @relation(fields: [scenarioId], references: [id])

  @@index([orgId])
  @@index([scenarioId])
}

enum QuoteStatus {
  Draft
  PendingApproval
  Sent
  Accepted
  Rejected
  Expired
  Superseded
}

/// ⚠️ walkAwayPrice مُنفَّذ كـTrigger على مستوى القاعدة (migration الـRLS) — مش تحقق واجهة بس،
/// طبقًا لقاعدة CLAUDE.md غير القابلة للتفاوض عن القيود التجارية الحرجة.
model Quote {
  id         String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId      String      @db.Uuid
  dealId     String      @db.Uuid
  scenarioId String      @db.Uuid
  version    Int
  customerId String      @db.Uuid
  currency   String      @db.Char(3)
  incoterm   Incoterm
  namedPlace String?
  validUntil DateTime?
  unitPrice  Decimal     @db.Decimal(14, 4)
  priceUnit  String
  status     QuoteStatus @default(Draft)
  approvalId String?     @db.Uuid
  /// تجميع بصري بس لعرض أسعار مستقلة في مستند واحد للعميل — كل Quote هنا لسه ليه Deal/DealScenario/
  /// walkAwayPrice مستقل بالكامل زي ما هو، مفيش أي تغيير في محرك التسعير نفسه (راجع QuoteBundle).
  bundleId   String?     @db.Uuid
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  deal     Deal         @relation(fields: [dealId], references: [id])
  scenario DealScenario @relation(fields: [scenarioId], references: [id])
  customer Company      @relation("QuoteCustomer", fields: [customerId], references: [id])
  approval Approval?    @relation(fields: [approvalId], references: [id])
  bundle   QuoteBundle? @relation(fields: [bundleId], references: [id])

  @@unique([dealId, version])
  @@index([orgId])
  @@index([scenarioId])
  @@index([bundleId])
}

/// تجميع عروض أسعار مستقلة (Deals مختلفة، نفس العميل) في مستند واحد بيتبعت مرة واحدة — نفس
/// فلسفة تسعير التصدير الحقيقية: كل منتج تكلفته وwalkAwayPrice بتاعته مختلفة، فمفيش "Deal
/// واحدة بمنتجات متعددة"، لكن العميل بيستحق مستند واحد بدل عرض منفصل لكل منتج. القاعدة الوحيدة
/// المفروضة: كل الـQuotes في الحزمة لازم تكون لنفس العميل (Trigger enforce_quote_bundle_same_customer).
model QuoteBundle {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId      String   @db.Uuid
  customerId String   @db.Uuid
  createdBy  String   @db.Uuid
  createdAt  DateTime @default(now())

  organization  Organization @relation(fields: [orgId], references: [id])
  customer      Company      @relation(fields: [customerId], references: [id])
  createdByUser User         @relation(fields: [createdBy], references: [id])
  quotes        Quote[]

  @@index([orgId])
  @@index([customerId])
}

enum SalesOrderStatus {
  Draft
  Confirmed
  InProduction
  PartiallyDelivered
  Delivered
  Invoiced
  Closed
  Cancelled
}

/// "Won" وحدها مش التزام تجاري حقيقي (ERD §5، 🆕v4) — الالتزام الفعلي يبدأ من هنا، بدليل PO حقيقي.
/// ⚠️ إنفاذ إلزامي على مستوى القاعدة (CHECK constraint، migration الـRLS): أي status غير Draft
/// لازم يكون معاه poNumber+poDate فعليًا — مش تحقق واجهة بس.
/// مؤجَّل عن قصد: poDocumentId (رفع مستند PO فعلي) — يحتاج Supabase Storage/Signed URLs لسه مبنيّة،
/// راجع docs/SCOPE-P2.md.
model SalesOrder {
  id                  String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId               String           @db.Uuid
  dealId              String           @db.Uuid
  customerId          String           @db.Uuid
  soNumber            String           @unique
  poNumber            String?
  poDate              DateTime?
  currency            String           @db.Char(3)
  totalValue          Decimal          @db.Decimal(14, 2)
  incoterm            Incoterm
  paymentTerms        String?
  deliveryWindowStart DateTime?
  deliveryWindowEnd   DateTime?
  status              SalesOrderStatus @default(Draft)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  deal              Deal              @relation(fields: [dealId], references: [id])
  customer          Company           @relation("SalesOrderCustomer", fields: [customerId], references: [id])
  lines             SalesOrderLine[]
  commissionEntries CommissionEntry[]
  invoices          Invoice[]

  @@index([orgId])
  @@index([dealId])
}

model SalesOrderLine {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String   @db.Uuid
  salesOrderId String   @db.Uuid
  productId    String   @db.Uuid
  quantity     Decimal  @db.Decimal(14, 3)
  unitPrice    Decimal  @db.Decimal(14, 4)
  currency     String   @db.Char(3)
  createdAt    DateTime @default(now())

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@index([orgId])
  @@index([salesOrderId])
}

// ==================== الوحدة 5 — الامتثال والجمارك (شريحة أولى، ERD v3 §8) ====================
// نطاق هذه الشريحة: ComplianceCase/Requirement/Gate/HSClassification/Certificate بس —
// راجع docs/SCOPE-P5.md للتفاصيل والتأجيلات المقصودة (Registration, OriginProof, RejectionCase,
// LCRequirement — وحدة 6/7 لسه ما اتبنتش، فمفيش Shipment/Supplier يتربطوا بيهم أصلًا).

enum ComplianceOperationType {
  CommercialExport
  Sample
  Tender
  TrialShipment
  AnnualContract
  PrivateLabel
}

enum ComplianceCaseStatus {
  Draft
  UnderAssessment
  MissingInformation
  Conditional
  Compliant
  Hold
  Blocked
  ApprovedForPricing
  ApprovedForContract
  ApprovedForProduction
  ApprovedForShipment
  Closed
  Rejected
}

/// ⚠️ بلا readinessScore/riskScore عمدًا — نفس قرار DealScenario.dealScore/costConfidenceScore
/// في docs/SCOPE-P2.md §3 ("لا تُعطِ درجة موزونة بلا تبرير"، ERD §3). بترجع لما ScoreSnapshot يتبني.
/// shipments موجود فعليًا (وحدة 6، الشريحة الأولى، 30 أغسطس) عبر Shipment.complianceCaseId.
model ComplianceCase {
  id                      String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                   String                  @db.Uuid
  dealId                  String                  @db.Uuid
  scenarioId              String?                 @db.Uuid
  productId               String                  @db.Uuid
  marketId                String                  @db.Uuid
  supplierId              String?                 @db.Uuid
  operationType           ComplianceOperationType
  status                  ComplianceCaseStatus    @default(Draft)
  estimatedComplianceCost Decimal?                @db.Decimal(14, 2)
  estimatedComplianceDays Int?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  deletedAt               DateTime?

  organization   Organization    @relation(fields: [orgId], references: [id])
  deal           Deal            @relation(fields: [dealId], references: [id])
  scenario       DealScenario?   @relation(fields: [scenarioId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  market         Market          @relation(fields: [marketId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  requirements   Requirement[]
  gates          Gate[]
  rejectionCases RejectionCase[]
  shipments      Shipment[]

  @@index([orgId])
  @@index([dealId])
  @@index([supplierId])
}

enum RequirementCategory {
  MarketAccess
  Customs
  Health
  Phytosanitary
  Quality
  Packaging
  Labeling
  Origin
  Transport
  Banking
}

enum RequirementStatus {
  NotApplicable
  Applicable
  PossiblyApplicable
  Met
  PartiallyMet
  NotMet
  Blocking
  NeedsExpertReview
}

/// complianceCaseId أو (productId+marketId) — لازم أحدهما يتملى، مش الاتنين (بحث متطلبات سوق عام
/// قبل وجود صفقة أصلًا، ERD §8 ملاحظة 🆕v3.1). يتفحص في الـServer Action، بلا CHECK constraint
/// (منطق شرطي، مش قيد مالي/أمني حرج يستاهل Trigger). evidenceId/sourceId اتشالوا (Attachment/Source
/// مش مبنيين لسه).
model Requirement {
  id               String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String              @db.Uuid
  complianceCaseId String?             @db.Uuid
  productId        String?             @db.Uuid
  marketId         String?             @db.Uuid
  category         RequirementCategory
  name             String
  mandatory        Boolean             @default(true)
  status           RequirementStatus   @default(Applicable)
  responsibleParty String?
  issuingAuthority String?
  estimatedCost    Decimal?            @db.Decimal(14, 2)
  estimatedDays    Int?
  dueDate          DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization   Organization    @relation(fields: [orgId], references: [id])
  complianceCase ComplianceCase? @relation(fields: [complianceCaseId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  market         Market?         @relation(fields: [marketId], references: [id])

  @@index([orgId])
  @@index([complianceCaseId])
}

enum GateStatus {
  Passed
  PassedWithConditions
  Pending
  Failed
  Waived
  NotApplicable
}

/// إنفاذ إلزامي على مستوى القاعدة (Trigger، migration الـRLS بتاعة الوحدة دي):
/// (1) status=Waived لازم يكون معاه approvalId لصف Approval معتمد (نفس نمط enforce_quote_walk_away_price).
/// (2) status=Passed لازم كل Requirement في blockingRequirementIds تكون Met أو NotApplicable.
/// (3) requiresOriginProofVerification=true محتاج OriginProof متحقّق (وحدة 5، الشريحة الثانية).
/// (4) requiresAciVerification=true محتاج Shipment.aciDeadlineMet=true أو aciStatus=NotRequired
///     (وحدة 6، الشريحة الأولى — enforce_gate_aci_deadline_met، ERD §8 ملاحظة سطر 288).
model Gate {
  id                              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                           String     @db.Uuid
  complianceCaseId                String     @db.Uuid
  gateNumber                      Int
  gateName                        String
  status                          GateStatus @default(Pending)
  blockingRequirementIds          String[]
  /// مش من الـERD الأصلي — إضافة معمارية (30 أغسطس، الشريحة الثانية) لتفعيل قاعدة PEM بدقة:
  /// "دي البوابة المسؤولة عن الشحن/الإبحار" بدل قاعدة عامة تفحص كل بوابات الحالة. راجع
  /// enforce_gate_origin_proof_verified في migration الشريحة الثانية وdocs/SCOPE-P5.md.
  requiresOriginProofVerification Boolean    @default(false)
  /// مش من الـERD الأصلي — نفس نمط requiresOriginProofVerification، بس لقاعدة مهلة ACI (وحدة 6).
  requiresAciVerification         Boolean    @default(false)
  decidedBy                       String?    @db.Uuid
  decidedAt                       DateTime?
  approvalId                      String?    @db.Uuid
  waiverExpiresAt                 DateTime?
  createdAt                       DateTime   @default(now())
  updatedAt                       DateTime   @updatedAt

  organization   Organization   @relation(fields: [orgId], references: [id])
  complianceCase ComplianceCase @relation(fields: [complianceCaseId], references: [id])
  decidedByUser  User?          @relation(fields: [decidedBy], references: [id])
  approval       Approval?      @relation(fields: [approvalId], references: [id])

  @@unique([complianceCaseId, gateNumber])
  @@index([orgId])
}

enum HSClassificationStatus {
  Proposed
  UnderReview
  ConfirmedInternally
  ConfirmedByBroker
  ConfirmedByRuling
  Disputed
  NeedsExpertReview
  Rejected
}

/// منفصل عن Product.hsCode (نص خام من وحدة 1) — ده تصنيف مُتتبَّع لكل زوج منتج×سوق بحالة اعتماد
/// حقيقية ونسبة رسوم جمركية. sourceId اتشال (Source مؤجَّل، نفس سبب docs/SCOPE-P2.md §3).
model HSClassification {
  id              String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId           String                 @db.Uuid
  productId       String                 @db.Uuid
  marketId        String                 @db.Uuid
  hsCode          String
  status          HSClassificationStatus @default(Proposed)
  confidenceScore Int?
  dutyRatePct     Decimal?               @db.Decimal(5, 2)
  rulingReference String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  market       Market       @relation(fields: [marketId], references: [id])

  @@index([orgId])
  @@index([productId, marketId])
}

enum CertificateType {
  HACCP
  BRCGS
  IFS
  FSSC
  GlobalGAP
  ISO
  Organic
  Halal
  Kosher
  GMP
  Phytosanitary
  HealthCertificate
  COA
  Fumigation
}

enum CertificateStatus {
  Valid
  ExpiringSoon
  Expired
  Suspended
  UnderRenewal
  Pending
  Rejected
  NotVerified
}

/// attachmentId اتشال (Attachment/Storage مش مبنيين لسه، نفس منطق poDocumentId المؤجَّل في SCOPE-P2.md).
model Certificate {
  id                  String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId               String            @db.Uuid
  companyId           String?           @db.Uuid
  productId           String?           @db.Uuid
  supplierId          String?           @db.Uuid
  facilityId          String?           @db.Uuid
  certificateType     CertificateType
  certificateNumber   String
  issuingAuthority    String
  issueDate           DateTime
  expiryDate          DateTime?
  scope               String?
  marketsCovered      String[]
  status              CertificateStatus @default(Valid)
  renewalLeadTimeDays Int?
  lastVerifiedAt      DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  company      Company?     @relation(fields: [companyId], references: [id])
  product      Product?     @relation(fields: [productId], references: [id])
  supplier     Supplier?    @relation(fields: [supplierId], references: [id])
  facility     Facility?    @relation(fields: [facilityId], references: [id])

  @@index([orgId])
  @@index([supplierId])
  @@index([facilityId])
}

// ==================== وحدة 5 (تابع) — شريحة تانية: Registration + OriginProof ====================
// راجع docs/SCOPE-P5.md §"الشريحة الثانية" للتفاصيل والتبسيطات الكاملة.

enum RegistrationType {
  FacilityRegistration
  ProductRegistration
  ExporterRegistration
  ImporterRegistration
  LabelRegistration
}

enum RegistrationStatus {
  NotStarted
  CollectingDocuments
  Submitted
  UnderReview
  InspectionRequired
  Approved
  Rejected
  Expired
  Suspended
  RenewalRequired
}

/// productId مربوطة بشاشة تفاصيل الحالة بمطابقة productId = ComplianceCase.productId.
model Registration {
  id                 String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId              String             @db.Uuid
  registrationType   RegistrationType
  country            String
  authority          String
  productId          String?            @db.Uuid
  supplierId         String?            @db.Uuid
  facilityId         String?            @db.Uuid
  registrationNumber String?
  submissionDate     DateTime?
  approvalDate       DateTime?
  expiryDate         DateTime?
  status             RegistrationStatus @default(NotStarted)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  product      Product?     @relation(fields: [productId], references: [id])
  supplier     Supplier?    @relation(fields: [supplierId], references: [id])
  facility     Facility?    @relation(fields: [facilityId], references: [id])

  @@index([orgId])
  @@index([supplierId])
  @@index([facilityId])
}

enum OriginProofType {
  EUR1
  InvoiceDeclaration
  StatementOnOrigin
  CertificateOfOrigin
}

enum OriginProofCumulationType {
  None
  Bilateral
  Diagonal
  Full
}

/// ⚠️ الـERD (docs/ERD.md §8) ذكر `status` بلا قيم enum محدّدة صراحةً — دي قيم تفسيرية موثّقة هنا،
/// بنفس روح enums المستندات التانية في نفس الوحدة (Certificate/HSClassification).
enum OriginProofStatus {
  Draft
  Issued
  Verified
  Rejected
  Expired
}

/// evidenceIds اتشال (Attachment/Storage مؤجَّلين، نفس سبب باقي حقول evidence في الوحدة).
///
/// ⚠️ revisedRulesWordingVerified: قواعد PEM المنقّحة لإثبات المنشأ المصري — سارية فعليًا من يناير
/// 2026 (CLAUDE.md §مواعيد نهائية قانونية). أي Gate بعلامة requiresOriginProofVerification=true
/// لازم تتحقق من الحقل ده = true قبل ما تعدّي — Trigger enforce_gate_origin_proof_verified على
/// مستوى القاعدة (migration الشريحة الثانية)، مش تحقق واجهة بس.
model OriginProof {
  id                          String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                       String                     @db.Uuid
  dealId                      String                     @db.Uuid
  shipmentId                  String?                    @db.Uuid
  proofType                   OriginProofType
  usesRevisedPemRules         Boolean                    @default(false)
  revisedRulesWordingVerified Boolean                    @default(false)
  cumulationType              OriginProofCumulationType?
  certificateNumber           String?
  issuedDate                  DateTime?
  issuingAuthority            String?
  status                      OriginProofStatus          @default(Draft)
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  deal         Deal         @relation(fields: [dealId], references: [id])
  shipment     Shipment?    @relation(fields: [shipmentId], references: [id])

  @@index([orgId])
  @@index([dealId])
  @@index([shipmentId])
}

enum RejectionType {
  DocumentRejection
  SampleRejection
  TestFailure
  LabelRejection
  CustomsHold
  OriginRejection
  HSDispute
  HealthRejection
  WeightMismatch
}

enum RejectionSeverity {
  Low
  Medium
  High
  Critical
}

/// قرار تفسيري (الـERD ما حدّدش قيم enum صراحةً لـstatus هنا، زي OriginProofStatus قبل كده) —
/// دورة حياة رفض جمركي/فحص واقعية: بيتفتح، بيتحقّق فيه، ممكن يحتاج CAPA، وبيتقفل بنتيجة.
enum RejectionCaseStatus {
  Open
  UnderInvestigation
  CAPARequired
  Resolved
  Closed
  Disputed
}

/// complianceCaseId إلزامي (مطابق للـERD)، مربوطة مباشرة بشاشة تفاصيل الحالة، بلا حاجة مطابقة
/// استنتاجية زي Certificate.
model RejectionCase {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId             String              @db.Uuid
  complianceCaseId  String              @db.Uuid
  capaId            String?             @db.Uuid
  shipmentId        String?             @db.Uuid
  rejectionType     RejectionType
  authority         String
  severity          RejectionSeverity
  financialExposure Decimal?            @db.Decimal(14, 2)
  currency          String?
  status            RejectionCaseStatus @default(Open)
  finalResult       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization   Organization   @relation(fields: [orgId], references: [id])
  complianceCase ComplianceCase @relation(fields: [complianceCaseId], references: [id])
  capa           CAPA?          @relation(fields: [capaId], references: [id])
  shipment       Shipment?      @relation(fields: [shipmentId], references: [id])

  @@index([orgId])
  @@index([complianceCaseId])
  @@index([capaId])
  @@index([shipmentId])
}

/// dealId إلزامي (نفس نمط OriginProof بالظبط) — ربط مباشر بالصفقة، عرض في شاشة تفاصيل الحالة
/// بمطابقة dealId = ComplianceCase.dealId. مفيش status — الـERD مش بيذكر واحد لهذا الكيان أصلًا؛
/// ده توثيق شروط LC، مش Workflow object بحالة متغيّرة. requiredDocuments كـString[] بدل jsonb —
/// نفس قرار Gate.blockingRequirementIds/Certificate.marketsCovered (قايمة نصية بسيطة).
model LCRequirement {
  id                     String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                  String    @db.Uuid
  dealId                 String    @db.Uuid
  lcNumber               String
  issuingBank            String
  amount                 Decimal   @db.Decimal(14, 2)
  currency               String
  expiryDate             DateTime
  latestShipmentDate     DateTime?
  presentationPeriodDays Int?
  requiredDocuments      String[]
  requiredWording        String?
  partialShipmentAllowed Boolean   @default(false)
  transshipmentAllowed   Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  deal         Deal         @relation(fields: [dealId], references: [id])

  @@index([orgId])
  @@index([dealId])
}

// ==================== الوحدة 6 — اللوجستيات (ERD §9) — الشريحة الأولى (30 أغسطس) ====================
// الحلقة الأساسية بس: Shipment/ShipmentParty/Booking/Container/Milestone (5 من 17 كيان).
// مؤجَّل: ShipmentLot (محتاج Lot من وحدة 7)، Route/FreightQuote/FreightQuoteLine/ServiceProvider
// (تسعير الشحن، محتاج بيانات مزوّدين حقيقية)، ShipmentEvent/TemperatureLog/TransportTrip/
// FreeTimeRecord/LogisticsException/Claim/ActualLogisticsCost (تشغيل ميداني بعد ما الحلقة تشتغل).

enum ShipmentType {
  Commercial
  Sample
  Trial
  Tender
  Consolidated
}

enum TransportMode {
  Sea
  Air
  Road
  Rail
  Multimodal
  Courier
}

enum LoadType {
  FCL
  LCL
}

enum ShipmentStatus {
  Draft
  Planning
  AwaitingRates
  BookingRequested
  BookingConfirmed
  CargoPreparation
  Loading
  CustomsClearance
  GateIn
  Departed
  InTransit
  Transshipment
  Arrived
  CustomsHold
  Clearance
  OutForDelivery
  Delivered
  EmptyReturned
  Closed
  Cancelled
  Exception
}

enum AciStatus {
  NotRequired
  Pending
  Submitted
  Approved
  Rejected
}

/// ⚠️ بلا readinessScore/riskScore عمدًا — نفس قرار ComplianceCase (schema.prisma §وحدة 5،
/// "لا تُعطِ درجة موزونة بلا تبرير"). aciDeadlineMet مش DB generated column (PG17.6 معقّد مع
/// interval logic) — عمود Boolean عادي بيتحسب في createShipment/updateShipmentAci Server Action
/// من aciSubmittedAt <= etd - interval '48 hours'، نفس قرار DealScenario.quantitySaleable
/// (docs/SCOPE-P2.md). الـTrigger على Gate (enforce_gate_aci_deadline_met) بيقرا القيمة المخزَّنة
/// دي مباشرة، بلا حساب مكرر جوه الـDB.
///
/// ⚠️ aciSubmittedAt: الـACID لازم يتصدر قبل 48 ساعة على الأقل من مغادرة البضاعة (ERD §9 ملاحظة).
/// المهلة دي قيد ملزم على المسار الحرج — Gate الشحن/الإبحار في وحدة 5 لازم تفحص aciDeadlineMet
/// صراحة قبل Passed (ERD §8 ملاحظة سطر 288)، وده بالظبط الـTrigger الرابع على Gate هنا.
model Shipment {
  id               String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String         @db.Uuid
  dealId           String         @db.Uuid
  productId        String         @db.Uuid
  complianceCaseId String?        @db.Uuid
  shipmentType     ShipmentType
  transportMode    TransportMode
  loadType         LoadType?
  incoterm         Incoterm
  originPort       String
  destinationPort  String
  finalDestination String?
  cargoReadyDate   DateTime?
  etd              DateTime?
  actualDeparture  DateTime?
  eta              DateTime?
  revisedEta       DateTime?
  actualArrival    DateTime?
  status           ShipmentStatus @default(Draft)
  acidNumber       String?
  aciStatus        AciStatus      @default(NotRequired)
  aciSubmittedAt   DateTime?
  aciDeadlineMet   Boolean        @default(false)
  cargoXRef        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  organization     Organization          @relation(fields: [orgId], references: [id])
  deal             Deal                  @relation(fields: [dealId], references: [id])
  product          Product               @relation(fields: [productId], references: [id])
  complianceCase   ComplianceCase?       @relation(fields: [complianceCaseId], references: [id])
  parties          ShipmentParty[]
  bookings         Booking[]
  containers       Container[]
  milestones       Milestone[]
  events           ShipmentEvent[]
  exceptions       LogisticsException[]
  freeTimeRecords  FreeTimeRecord[]
  actualCosts      ActualLogisticsCost[]
  temperatureLogs  TemperatureLog[]
  transportTrips   TransportTrip[]
  claims           Claim[]
  shipmentLots     ShipmentLot[]
  cargoReadiness   CargoReadiness[]
  documents        Document[]
  rejectionCases   RejectionCase[]
  originProofs     OriginProof[]
  documentPackages DocumentPackage[]
  journalLines     JournalLine[]

  @@index([orgId])
  @@index([dealId])
  @@index([complianceCaseId])
}

enum PartyRole {
  Buyer
  Consignee
  NotifyParty
  ImporterOfRecord
  CustomsBroker
}

/// بديل customerId المفرد — شحنة واحدة ممكن يكون فيها 4 أطراف مختلفة (ERD §9).
model ShipmentParty {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId      String    @db.Uuid
  shipmentId String    @db.Uuid
  partyRole  PartyRole
  companyId  String    @db.Uuid
  createdAt  DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  shipment     Shipment     @relation(fields: [shipmentId], references: [id])
  company      Company      @relation(fields: [companyId], references: [id])

  @@index([orgId])
  @@index([shipmentId])
}

enum BookingStatus {
  Draft
  Requested
  Pending
  Confirmed
  Amended
  Rolled
  Split
  Cancelled
  Expired
  Completed
}

/// providerId/freightQuoteId (اختياريين) بيرجعوا لـService Provider/FreightQuote (الشريحة الرابعة،
/// 30 أغسطس) — كانوا اتشالوا في الشريحة الأولى لغياب الكيانين، دلوقتي موجودين.
model Booking {
  id                  String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId               String        @db.Uuid
  shipmentId          String        @db.Uuid
  bookingNumber       String?
  vessel              String?
  voyage              String?
  etd                 DateTime?
  eta                 DateTime?
  documentationCutoff DateTime?
  vgmDeadline         DateTime?
  portClosingDate     DateTime?
  freeTimeDays        Int?
  providerId          String?       @db.Uuid
  freightQuoteId      String?       @db.Uuid
  status              BookingStatus @default(Draft)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id])
  shipment     Shipment         @relation(fields: [shipmentId], references: [id])
  provider     ServiceProvider? @relation(fields: [providerId], references: [id])
  freightQuote FreightQuote?    @relation(fields: [freightQuoteId], references: [id])

  @@index([orgId])
  @@index([shipmentId])
}

enum ContainerType {
  GP20
  GP40
  HC40
  RF20
  RF40
  HCRF40
  OpenTop
  FlatRack
  Tank
}

/// weightUtilization/volumeUtilization/isOverweight (⚙️) بيتحسبوا وقت العرض في الصفحة (getter بسيط)
/// مش أعمدة مخزَّنة — نفس نمط FreeTimeRecord.chargeDays وActualLogisticsCost.variance تحت.
model Container {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId           String        @db.Uuid
  shipmentId      String        @db.Uuid
  containerNumber String?
  containerType   ContainerType
  sealNumber      String?
  maxPayload      Decimal?      @db.Decimal(10, 2)
  netWeight       Decimal?      @db.Decimal(10, 2)
  grossWeight     Decimal?      @db.Decimal(10, 2)
  usedVolume      Decimal?      @db.Decimal(10, 3)
  availableVolume Decimal?      @db.Decimal(10, 3)
  setPointTempC   Decimal?      @db.Decimal(5, 2)
  vgmSubmittedAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization     @relation(fields: [orgId], references: [id])
  shipment        Shipment         @relation(fields: [shipmentId], references: [id])
  freeTimeRecords FreeTimeRecord[]
  temperatureLogs TemperatureLog[]

  @@index([orgId])
  @@index([shipmentId])
}

enum MilestoneStatus {
  NotStarted
  Planned
  InProgress
  Completed
  Delayed
  Missed
  Blocked
  NotApplicable
}

/// 8 معالم ثابتة بتتقترح تلقائيًا من createShipment (Cargo Ready, Booking Confirmed, Empty
/// Container Pickup, Loading Completed, VGM Submitted, Customs Cleared Export, Gate-In, Vessel
/// Departed, Destination Arrival, Delivered) — جدول مرن بدل الـ32 معلم اليدوي في المواصفة الأصلية
/// (ERD §9)، اختيرت لأنها تحمل التزام مالي/قانوني فعلي (Free Time، VGM، ACI).
model Milestone {
  id            String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId         String          @db.Uuid
  shipmentId    String          @db.Uuid
  milestoneName String
  sequence      Int
  plannedDate   DateTime?
  forecastDate  DateTime?
  actualDate    DateTime?
  status        MilestoneStatus @default(NotStarted)
  ownerId       String?         @db.Uuid
  delayReason   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  shipment     Shipment     @relation(fields: [shipmentId], references: [id])
  owner        User?        @relation("MilestoneOwner", fields: [ownerId], references: [id])

  @@index([orgId])
  @@index([shipmentId])
}

// ==================== الوحدة 6 — اللوجستيات: الشريحة الثانية (التتبع التشغيلي، 30 أغسطس) ====================
// ShipmentEvent/LogisticsException/FreeTimeRecord/ActualLogisticsCost (4 من الـ12 كيان المتبقي).
// بلا Trigger جديد — مفيش قيد عمل حرج مذكور في docs/ERD.md/CLAUDE.md بيتعلق بيهم (نفس فلسفة
// RejectionCase/LCRequirement في وحدة 5 الشريحة الثالثة). راجع docs/SCOPE-P6.md.
// مؤجَّل: TemperatureLog/TransportTrip (تخصص تبريد/نقل بري)، Claim (نتيجة LogisticsException،
// أنضف بعد ما يبقى فيه استثناءات حقيقية)، ShipmentLot/Route/FreightQuote/ServiceProvider (نفس
// تأجيلات الشريحة الأولى).

enum ShipmentEventSource {
  Manual
  ShippingLineWebsite
  FreightForwarder
  Port
  CustomsBroker
  Customer
  ImportedCSV
  API
}

/// eventType نص حر — الـERD (§9) مش بيحدد enum ثابت له (سجل أحداث مفتوح، عكس LogisticsException).
/// reliability Int? (نسبة ثقة 0-100) — نفس نمط HSClassification.confidenceScore.
model ShipmentEvent {
  id          String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId       String              @db.Uuid
  shipmentId  String              @db.Uuid
  eventType   String
  occurredAt  DateTime
  location    String?
  source      ShipmentEventSource @default(Manual)
  reliability Int?
  enteredBy   String?             @db.Uuid
  createdAt   DateTime            @default(now())

  organization  Organization @relation(fields: [orgId], references: [id])
  shipment      Shipment     @relation(fields: [shipmentId], references: [id])
  enteredByUser User?        @relation("ShipmentEventEnteredBy", fields: [enteredBy], references: [id])

  @@index([orgId])
  @@index([shipmentId])
}

enum LogisticsExceptionType {
  BookingRejected
  ContainerShortage
  TruckDelay
  LoadingDelay
  CustomsHold
  DocumentationError
  VGMError
  SealMismatch
  Overweight
  GateInMissed
  VesselDelay
  VesselChange
  RollOver
  PortCongestion
  TransshipmentDelay
  CargoDamage
  TemperatureExcursion
  ReeferFailure
  Shortage
  Demurrage
  Detention
  Strike
  Weather
  PortClosure
}

enum LogisticsExceptionSeverity {
  Informational
  Low
  Medium
  High
  Critical
}

enum LogisticsExceptionStatus {
  Open
  InProgress
  Resolved
  Closed
}

model LogisticsException {
  id                 String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId              String                     @db.Uuid
  shipmentId         String                     @db.Uuid
  exceptionType      LogisticsExceptionType
  severity           LogisticsExceptionSeverity
  detectedAt         DateTime
  rootCause          String?
  financialExposure  Decimal?                   @db.Decimal(14, 2)
  scheduleImpactDays Int?
  recoveryPlan       String?
  status             LogisticsExceptionStatus   @default(Open)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  shipment     Shipment     @relation(fields: [shipmentId], references: [id])

  @@index([orgId])
  @@index([shipmentId])
}

enum FreeTimeChargeType {
  Demurrage
  Detention
}

enum FreeTimeLocation {
  Origin
  Destination
}

/// chargeDays (⚙️) بيتحسب وقت العرض في الصفحة من startDate/endDate/freeDays — مش عمود مخزَّن،
/// نفس نمط Container.weightUtilization بالظبط. containerId اختياري (شحنات LCL بلا حاوية مخصَّصة).
model FreeTimeRecord {
  id               String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String             @db.Uuid
  shipmentId       String             @db.Uuid
  containerId      String?            @db.Uuid
  chargeType       FreeTimeChargeType
  location         FreeTimeLocation
  freeDays         Int?
  startDate        DateTime?
  endDate          DateTime?
  tierRates        Json?
  estimatedCost    Decimal?           @db.Decimal(14, 2)
  actualCost       Decimal?           @db.Decimal(14, 2)
  currency         String?
  responsibleParty String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  shipment     Shipment     @relation(fields: [shipmentId], references: [id])
  container    Container?   @relation(fields: [containerId], references: [id])

  @@index([orgId])
  @@index([shipmentId])
}

/// variance (⚙️) بيتحسب وقت العرض (actualAmount - expectedAmount) — مش عمود مخزَّن، نفس نمط
/// Container.weightUtilization.
model ActualLogisticsCost {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String   @db.Uuid
  shipmentId       String   @db.Uuid
  costType         String
  expectedAmount   Decimal? @db.Decimal(14, 2)
  actualAmount     Decimal? @db.Decimal(14, 2)
  currency         String?
  fxRateId         String?  @db.Uuid
  invoiceReference String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization  @relation(fields: [orgId], references: [id])
  shipment     Shipment      @relation(fields: [shipmentId], references: [id])
  fxRate       ExchangeRate? @relation(fields: [fxRateId], references: [id])

  @@index([orgId])
  @@index([shipmentId])
}

// ==================== الوحدة 6 — اللوجستيات: الشريحة الثالثة (30 أغسطس) ====================
// TemperatureLog/TransportTrip/Claim (3 من الـ8 كيان المتبقي، راجع docs/ERD.md §9 وdocs/SCOPE-P6.md).
// بلا Trigger جديد — مفيش قيد عمل حرج مذكور بيتعلق بيهم (نفس فلسفة الشريحة الثانية).
// مؤجَّل: ShipmentLot (محتاج Lot من وحدة 7)، Route/FreightQuote/ServiceProvider (تسعير الشحن).

/// containerId اختياري (شحنات LCL بلا حاوية مخصَّصة). source نص حر — الـERD مش بيحدد enum له.
model TemperatureLog {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String   @db.Uuid
  shipmentId   String   @db.Uuid
  containerId  String?  @db.Uuid
  recordedAt   DateTime
  temperatureC Decimal  @db.Decimal(5, 2)
  humidityPct  Decimal? @db.Decimal(5, 2)
  source       String?
  deviceId     String?
  isExcursion  Boolean  @default(false)
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  shipment     Shipment     @relation(fields: [shipmentId], references: [id])
  container    Container?   @relation(fields: [containerId], references: [id])

  @@index([orgId])
  @@index([shipmentId])
}

enum TransportTripStatus {
  Scheduled
  InProgress
  Completed
  Delayed
  Cancelled
}

/// status enum قرار تفسيري (الـERD ما حدّدش قيم صراحةً، زي OriginProofStatus قبل كده).
/// driverPhone 🔒 معلَّم بيانات شخصية في الـERD — مشفّر عبر Supabase Vault (src/lib/vault.ts)،
/// نفس نمط Company.bankAccountName/bankIBAN/bankSWIFT بالظبط. بلا واجهة إدخال لسه.
model TransportTrip {
  id                  String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId               String              @db.Uuid
  shipmentId          String              @db.Uuid
  carrier             String?
  vehicleNumber       String?
  driverName          String?
  driverPhoneSecretId String?             @db.Uuid
  pickupLocation      String?
  appointmentAt       DateTime?
  loadingStart        DateTime?
  loadingFinish       DateTime?
  gateInAt            DateTime?
  emptyReturnAt       DateTime?
  cost                Decimal?            @db.Decimal(14, 2)
  currency            String?
  status              TransportTripStatus @default(Scheduled)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  shipment     Shipment     @relation(fields: [shipmentId], references: [id])

  @@index([orgId])
  @@index([shipmentId])
}

enum ClaimType {
  CargoDamage
  TemperatureDamage
  WetDamage
  Shortage
  Loss
  Delay
  ContainerDamage
  Overcharge
  InvoiceDispute
  DemurrageDispute
  ServiceFailure
}

enum ClaimStatus {
  Draft
  EvidenceCollection
  Submitted
  UnderReview
  AdditionalInfoRequired
  Accepted
  PartiallyAccepted
  Rejected
  Settled
  Closed
}

model Claim {
  id               String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String      @db.Uuid
  shipmentId       String      @db.Uuid
  claimType        ClaimType
  claimedAgainst   String?
  incidentDate     DateTime?
  notificationDate DateTime?
  claimDeadline    DateTime?
  claimedAmount    Decimal?    @db.Decimal(14, 2)
  currency         String?
  settlementAmount Decimal?    @db.Decimal(14, 2)
  status           ClaimStatus @default(Draft)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  shipment     Shipment     @relation(fields: [shipmentId], references: [id])

  @@index([orgId])
  @@index([shipmentId])
}

// ==================== الوحدة 6 — اللوجستيات: الشريحة الرابعة والأخيرة (تسعير الشحن، 30 أغسطس) ====================
// ServiceProvider/Route/FreightQuote/FreightQuoteLine — كيانات بيانات أساسية (Master Data) مستقلة،
// مش تابعة لشحنة بعينها (عكس كل كيانات الشرايح التلاتة السابقة). بلا Trigger — مفيش قيد عمل حرج
// بيتعلق بيهم. بعد الشريحة دي وحدة 6 بتبقى 16/17 — ShipmentLot الاستثناء الوحيد المتبقي (محتاج Lot
// من وحدة 7). راجع docs/SCOPE-P6.md.

enum ServiceProviderType {
  ShippingLine
  FreightForwarder
  TruckingCompany
  CustomsBroker
  PortAgent
  Warehouse
  Surveyor
  InsuranceCompany
  Courier
  ColdStorage
  ContainerDepot
}

enum ServiceProviderStatus {
  Preferred
  Approved
  Conditional
  UnderReview
  Suspended
  Blacklisted
}

/// performanceScore (⚙️) اتشال — نفس قرار Shipment.readinessScore/riskScore ("لا تُعطِ درجة موزونة
/// بلا تبرير"، docs/SCOPE-P5.md §3). onTimePerformance/invoiceAccuracy بيتسجّلوا يدويًا لحد ما محرك
/// تجميع حقيقي (ScoreSnapshot) يتبني.
model ServiceProvider {
  id                String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId             String                @db.Uuid
  providerType      ServiceProviderType
  name              String
  country           String?
  onTimePerformance Decimal?              @db.Decimal(5, 2)
  invoiceAccuracy   Decimal?              @db.Decimal(5, 2)
  status            ServiceProviderStatus @default(UnderReview)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization  Organization   @relation(fields: [orgId], references: [id])
  freightQuotes FreightQuote[]
  bookings      Booking[]

  @@index([orgId])
}

enum RouteClassification {
  Preferred
  Approved
  Conditional
  HighRisk
  Avoid
  UnderReview
}

/// reliabilityScore/riskScore اتشالوا — نفس سبب ServiceProvider.performanceScore.
model Route {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId              String              @db.Uuid
  originPort         String
  destinationPort    String
  transportModes     String[]
  transitPorts       String[]
  transshipmentCount Int?
  typicalTransitDays Int?
  worstTransitDays   Int?
  weeklySailings     Int?
  classification     RouteClassification @default(UnderReview)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization  Organization   @relation(fields: [orgId], references: [id])
  freightQuotes FreightQuote[]

  @@index([orgId])
}

enum FreightQuoteStatus {
  Draft
  Approved
  Expired
}

/// originCharges/mainFreight/destinationCharges/insurance — البنود الإجمالية الأربعة للعرض السريع
/// فقط (زي ما ERD §9 بيوضّح)، التفصيل الفعلي في FreightQuoteLine. totalLogisticsCost/logisticsScore
/// (⚙️) بيتحسبوا وقت العرض من مجموع FreightQuoteLine.amount — مش أعمدة مخزَّنة، نفس نمط
/// Container.weightUtilization. logisticsScore اتشال زي باقي الـscores في الشريحة دي.
model FreightQuote {
  id                 String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId              String             @db.Uuid
  routeId            String             @db.Uuid
  providerId         String             @db.Uuid
  containerType      ContainerType?
  originCharges      Decimal?           @db.Decimal(14, 2)
  mainFreight        Decimal?           @db.Decimal(14, 2)
  destinationCharges Decimal?           @db.Decimal(14, 2)
  insurance          Decimal?           @db.Decimal(14, 2)
  currency           String?
  fxRateId           String?            @db.Uuid
  transitDays        Int?
  freeTimeDays       Int?
  validFrom          DateTime?
  validUntil         DateTime?
  status             FreightQuoteStatus @default(Draft)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization       @relation(fields: [orgId], references: [id])
  route        Route              @relation(fields: [routeId], references: [id])
  provider     ServiceProvider    @relation(fields: [providerId], references: [id])
  fxRate       ExchangeRate?      @relation(fields: [fxRateId], references: [id])
  lines        FreightQuoteLine[]
  bookings     Booking[]

  @@index([orgId])
  @@index([routeId])
  @@index([providerId])
}

enum FreightQuoteLineCategory {
  Origin
  Freight
  Destination
  Insurance
  Other
}

/// chargeCode نص حر — الـERD بيدّي أمثلة (THC, BunkerSurcharge, VGM, ReeferSurcharge, WarRisk,
/// DocumentationFee) بلا enum مغلق. بدونه Hidden Cost Detector (فحص بند فردي مفقود) غير قابل
/// للتنفيذ لاحقًا — نفس تبرير الـERD.
model FreightQuoteLine {
  id             String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId          String                   @db.Uuid
  freightQuoteId String                   @db.Uuid
  chargeCode     String
  category       FreightQuoteLineCategory
  amount         Decimal                  @db.Decimal(14, 2)
  currency       String?
  createdAt      DateTime                 @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  freightQuote FreightQuote @relation(fields: [freightQuoteId], references: [id])

  @@index([orgId])
  @@index([freightQuoteId])
}

// ==================== الوحدة 7 — التوريد والإنتاج والجودة (ESPPQC): الشريحة الأولى (30 أغسطس) ====================
// Supplier/Facility/SourcingRequest/SupplierQuote/PurchaseOrder (5 من 23 كيان، راجع docs/ERD.md §10
// وdocs/SCOPE-P7.md). Trigger أول لوحدة 7 (enforce_purchase_order_max_price) — نفس نمط
// enforce_quote_walk_away_price بالظبط بس عكسي (سقف مش أرضية). مؤجَّل: Farm/SupplierAudit/
// SupplyContract/SupplierRFQ (بقية شريحة التوريد)، و18 كيان إنتاج/جودة/مخزون (ProductionPlan/
// Inventory/Batch/Inspection/LabTest/QualityRelease/NCR/Lot/إلخ) — شرايح تالية.

enum SupplierStatus {
  Identified
  Contacted
  UnderReview
  DocumentsPending
  AuditRequired
  SampleRequired
  Conditional
  Approved
  Preferred
  Suspended
  Rejected
  Blacklisted
  Archived
}

/// qualificationScore/riskScore اتشالوا — نفس قرار كل الـscores الموزونة في المشروع ("لا تُعطِ درجة
/// بلا تبرير"). bankAccountName/bankIBAN 🔒 مشفّرين عبر Supabase Vault (src/lib/vault.ts) —
/// نفس نمط Company.bankAccountName/TransportTrip.driverPhone بالظبط.
model Supplier {
  id                      String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                   String         @db.Uuid
  legalName               String
  tradeName               String?
  country                 String?
  governorate             String?
  city                    String?
  taxId                   String?
  commercialRegNo         String?
  supplierType            String[]
  status                  SupplierStatus @default(Identified)
  bankAccountNameSecretId String?        @db.Uuid
  bankIBANSecretId        String?        @db.Uuid
  bankVerifiedAt          DateTime?
  /// نفس فلسفة إبقاء البيانات القديمة NULL بدل تلفيق منشئ وهمي — السجلات اللي اتعملت قبل إضافة العمود ده بتفضل NULL، وقاعدة فصل المهام مبتتفعّلش عليها.
  createdBy               String?        @db.Uuid
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  deletedAt               DateTime?

  organization       Organization          @relation(fields: [orgId], references: [id])
  createdByUser      User?                 @relation("SupplierCreatedBy", fields: [createdBy], references: [id])
  facilities         Facility[]
  sourcingQuotes     SupplierQuote[]
  purchaseOrders     PurchaseOrder[]
  batches            Batch[]
  ncrs               NCR[]
  farms              Farm[]
  supplierRFQs       SupplierRFQ[]
  audits             SupplierAudit[]
  contracts          SupplyContract[]
  packagingMaterials PackagingMaterial[]
  samples            SupplierSample[]
  performances       SupplierPerformance[]
  complianceCases    ComplianceCase[]
  certificates       Certificate[]
  registrations      Registration[]
  journalLines       JournalLine[]
  invoices           Invoice[]
  payments           Payment[]

  @@index([orgId])
}

enum FacilityType {
  Farm
  Field
  CollectionCenter
  PackingHouse
  Factory
  FreezingFacility
  DryingFacility
  ProcessingFacility
  Warehouse
  ColdStore
  Laboratory
}

enum FacilityStatus {
  Active
  UnderReview
  Suspended
  Closed
}

/// status enum قرار تفسيري (الـERD مش بيحدد قيم صراحةً)، نفس روح TransportTripStatus.
model Facility {
  id                    String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                 String         @db.Uuid
  supplierId            String         @db.Uuid
  facilityType          FacilityType
  name                  String
  address               String?
  capacityDaily         Decimal?       @db.Decimal(12, 2)
  productionLines       Int?
  shifts                Int?
  hasTraceabilitySystem Boolean        @default(false)
  lastAuditAt           DateTime?
  status                FacilityStatus @default(UnderReview)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organization    Organization     @relation(fields: [orgId], references: [id])
  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  purchaseOrders  PurchaseOrder[]
  batches         Batch[]
  inspections     Inspection[]
  productionPlans ProductionPlan[]
  ncrs            NCR[]
  audits          SupplierAudit[]
  certificates    Certificate[]
  registrations   Registration[]

  @@index([orgId])
  @@index([supplierId])
}

enum SourcingRequestStatus {
  Draft
  Approved
  RFQPreparation
  RFQSent
  QuotesReceived
  UnderEvaluation
  Negotiation
  SupplierSelected
  POIssued
  Cancelled
  Closed
}

/// ⚠️ maximumPurchasePrice: قيد عمل حرج — أمر شراء بسعر أعلى منه لازم يتمنع على مستوى القاعدة
/// (enforce_purchase_order_max_price تحت)، مش تحقق واجهة بس. راجع docs/ERD.md §10 سطر 350-352.
model SourcingRequest {
  id                       String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                    String                @db.Uuid
  dealId                   String                @db.Uuid
  productId                String                @db.Uuid
  marketId                 String                @db.Uuid
  specificationId          String?               @db.Uuid
  rawQuantityRequired      Decimal?              @db.Decimal(14, 3)
  saleableQuantityRequired Decimal?              @db.Decimal(14, 3)
  maximumPurchasePrice     Decimal               @db.Decimal(14, 4)
  targetPurchasePrice      Decimal?              @db.Decimal(14, 4)
  currency                 String
  requiredCargoReadyDate   DateTime?
  status                   SourcingRequestStatus @default(Draft)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  organization   Organization          @relation(fields: [orgId], references: [id])
  deal           Deal                  @relation(fields: [dealId], references: [id])
  product        Product               @relation(fields: [productId], references: [id])
  market         Market                @relation(fields: [marketId], references: [id])
  specification  ProductSpecification? @relation(fields: [specificationId], references: [id])
  quotes         SupplierQuote[]
  purchaseOrders PurchaseOrder[]
  supplierRFQs   SupplierRFQ[]

  @@index([orgId])
  @@index([dealId])
  @@index([specificationId])
}

/// effectiveCostPerSaleableKg (⚙️) بيتحسب وقت العرض (totalEffectiveCost / (availableQuantity *
/// expectedYield))، مش عمود مخزَّن — نفس نمط Container.weightUtilization. selectionScore اتشال
/// (score موزون).
model SupplierQuote {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId              String    @db.Uuid
  sourcingRequestId  String    @db.Uuid
  supplierId         String    @db.Uuid
  unitPrice          Decimal   @db.Decimal(14, 4)
  priceUnit          String?
  currency           String
  fxRateId           String?   @db.Uuid
  packagingIncluded  Boolean   @default(false)
  transportIncluded  Boolean   @default(false)
  paymentTerms       String?
  leadTimeDays       Int?
  availableQuantity  Decimal?  @db.Decimal(14, 3)
  minimumOrder       Decimal?  @db.Decimal(14, 3)
  expectedYield      Decimal?  @db.Decimal(5, 4)
  totalEffectiveCost Decimal?  @db.Decimal(14, 2)
  validUntil         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization    Organization    @relation(fields: [orgId], references: [id])
  sourcingRequest SourcingRequest @relation(fields: [sourcingRequestId], references: [id])
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  fxRate          ExchangeRate?   @relation(fields: [fxRateId], references: [id])

  @@index([orgId])
  @@index([sourcingRequestId])
}

enum PurchaseOrderStatus {
  Draft
  PendingApproval
  Approved
  Sent
  Acknowledged
  PartiallyConfirmed
  Confirmed
  InProduction
  PartiallyDelivered
  Delivered
  Closed
  Cancelled
  Disputed
}

/// Trigger enforce_purchase_order_max_price (migration الـRLS بتاعة الشريحة دي) بيمنع
/// unitPrice > SourcingRequest.maximumPurchasePrice بلا Approval معتمد
/// (subjectType='PurchaseOrder.unitPrice_override') — نفس نمط enforce_quote_walk_away_price
/// بالظبط، عكسي (سقف مش أرضية).
model PurchaseOrder {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId             String              @db.Uuid
  sourcingRequestId String              @db.Uuid
  supplierId        String              @db.Uuid
  facilityId        String?             @db.Uuid
  specificationId   String?             @db.Uuid
  poNumber          String              @unique
  version           Int                 @default(1)
  quantity          Decimal             @db.Decimal(14, 3)
  unitPrice         Decimal             @db.Decimal(14, 4)
  currency          String
  fxRateId          String?             @db.Uuid
  deliverySchedule  Json?
  paymentTerms      String?
  penalties         String?
  status            PurchaseOrderStatus @default(Draft)
  approvalId        String?             @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization    Organization          @relation(fields: [orgId], references: [id])
  sourcingRequest SourcingRequest       @relation(fields: [sourcingRequestId], references: [id])
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  facility        Facility?             @relation(fields: [facilityId], references: [id])
  specification   ProductSpecification? @relation(fields: [specificationId], references: [id])
  fxRate          ExchangeRate?         @relation(fields: [fxRateId], references: [id])
  approval        Approval?             @relation(fields: [approvalId], references: [id])
  batches         Batch[]
  productionPlans ProductionPlan[]
  cargoReadiness  CargoReadiness[]
  invoices        Invoice[]

  @@index([orgId])
  @@index([specificationId])
  @@index([sourcingRequestId])
}

enum BatchQualityStatus {
  Pending
  Released
  Held
  Rejected
}

enum BatchStatus {
  Planned
  InProduction
  Completed
  OnHold
  Cancelled
}

/// yieldRate/wasteQuantity (⚙️) بيتحسبوا وقت العرض (quantityOutput/quantityInput,
/// quantityInput-quantityOutput) — مش أعمدة مخزَّنة، نفس نمط Container.weightUtilization.
model Batch {
  id              String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId           String             @db.Uuid
  purchaseOrderId String             @db.Uuid
  facilityId      String             @db.Uuid
  supplierId      String             @db.Uuid
  batchCode       String             @unique
  productionDate  DateTime?
  expiryDate      DateTime?
  quantityInput   Decimal            @db.Decimal(14, 3)
  quantityOutput  Decimal?           @db.Decimal(14, 3)
  qualityStatus   BatchQualityStatus @default(Pending)
  status          BatchStatus        @default(Planned)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization             Organization             @relation(fields: [orgId], references: [id])
  purchaseOrder            PurchaseOrder            @relation(fields: [purchaseOrderId], references: [id])
  facility                 Facility                 @relation(fields: [facilityId], references: [id])
  supplier                 Supplier                 @relation(fields: [supplierId], references: [id])
  inspections              Inspection[]
  qualityReleases          QualityRelease[]
  lots                     Lot[]
  inventories              Inventory[]
  ncrs                     NCR[]
  labTests                 LabTest[]
  batchRawMaterialLines    BatchRawMaterialLine[]
  batchMarketEligibilities BatchMarketEligibility[]
  supplierSamples          SupplierSample[]
  customerSamples          CustomerSample[]

  @@index([orgId])
  @@index([purchaseOrderId])
}

enum InspectionStage {
  PreQualification
  IncomingRawMaterial
  DuringProduction
  PrePackaging
  PackagingInspection
  FinalProduct
  PreLoading
  ContainerInspection
}

enum InspectionResult {
  Pass
  ConditionalPass
  Fail
}

model Inspection {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId          String           @db.Uuid
  stage          InspectionStage
  batchId        String           @db.Uuid
  facilityId     String           @db.Uuid
  inspectorId    String           @db.Uuid
  inspectionDate DateTime         @default(now())
  samplingMethod String?
  sampleSize     Decimal?         @db.Decimal(10, 2)
  result         InspectionResult
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  batch        Batch        @relation(fields: [batchId], references: [id])
  facility     Facility     @relation(fields: [facilityId], references: [id])
  inspector    User         @relation(fields: [inspectorId], references: [id])
  labTests     LabTest[]

  @@index([orgId])
  @@index([batchId])
}

enum QualityReleaseStatus {
  Released
  PartialRelease
  ConditionalRelease
  Held
  Rejected
}

model QualityRelease {
  id                String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId             String               @db.Uuid
  batchId           String               @db.Uuid
  lotId             String?              @db.Uuid
  inspectionResults Json?
  releasedQuantity  Decimal?             @db.Decimal(14, 3)
  rejectedQuantity  Decimal?             @db.Decimal(14, 3)
  releaseDate       DateTime             @default(now())
  releasedBy        String               @db.Uuid
  status            QualityReleaseStatus @default(Held)
  createdAt         DateTime             @default(now())

  organization   Organization @relation(fields: [orgId], references: [id])
  batch          Batch        @relation(fields: [batchId], references: [id])
  lot            Lot?         @relation(fields: [lotId], references: [id])
  releasedByUser User         @relation("QualityReleaseReleasedBy", fields: [releasedBy], references: [id])

  @@index([orgId])
  @@index([batchId])
  @@index([lotId])
}

enum LotStatus {
  Draft
  Ready
  Allocated
  Shipped
  Consumed
  Cancelled
}

/// Trigger enforce_lot_quality_release (migration الـRLS بتاعة الشريحة دي) بيمنع
/// qualityStatus='Released' بلا QualityRelease معتمد (lotId=NEW.id أو batchId مطابق) —
/// نفس فلسفة enforce_gate_origin_proof_verified (فحص وجود صف مرتبط بحالة معيّنة).
model Lot {
  id               String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String             @db.Uuid
  batchId          String             @db.Uuid
  lotCode          String             @unique
  packingDate      DateTime?
  packagingVersion String?
  labelVersion     String?
  quantity         Decimal?           @db.Decimal(14, 3)
  cartons          Int?
  pallets          Int?
  netWeight        Decimal?           @db.Decimal(12, 3)
  grossWeight      Decimal?           @db.Decimal(12, 3)
  qualityStatus    BatchQualityStatus @default(Pending)
  status           LotStatus          @default(Draft)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization    Organization     @relation(fields: [orgId], references: [id])
  batch           Batch            @relation(fields: [batchId], references: [id])
  qualityReleases QualityRelease[]
  shipmentLots    ShipmentLot[]
  inventories     Inventory[]
  ncrs            NCR[]

  @@index([orgId])
  @@index([batchId])
}

/// جدول وسيط N:N بين Shipment (وحدة 6) وLot (وحدة 7) — بيسمح بالشحن الجزئي وSplit Container
/// (docs/ERD.md §9 سطر 302). بلا Trigger — توثيق بيانات بس، نفس فلسفة ShipmentEvent/ActualLogisticsCost.
model ShipmentLot {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId       String   @db.Uuid
  shipmentId  String   @db.Uuid
  lotId       String   @db.Uuid
  quantity    Decimal? @db.Decimal(14, 3)
  cartons     Int?
  netWeight   Decimal? @db.Decimal(12, 3)
  grossWeight Decimal? @db.Decimal(12, 3)
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  shipment     Shipment     @relation(fields: [shipmentId], references: [id])
  lot          Lot          @relation(fields: [lotId], references: [id])

  @@index([orgId])
  @@index([shipmentId])
  @@index([lotId])
}

enum ProductionProcess {
  Sorting
  Grading
  Washing
  Cutting
  Peeling
  Freezing
  Drying
  Milling
  Sterilization
  Fumigation
  Extraction
  Mixing
  Packing
  Labeling
  Palletizing
}

enum ProductionPlanStatus {
  Draft
  Scheduled
  MaterialsPending
  Ready
  InProduction
  QualityHold
  Rework
  Completed
  Delayed
  Cancelled
}

model ProductionPlan {
  id              String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId           String               @db.Uuid
  purchaseOrderId String               @db.Uuid
  facilityId      String               @db.Uuid
  process         ProductionProcess
  rawQuantity     Decimal?             @db.Decimal(14, 3)
  targetYield     Decimal?             @db.Decimal(5, 4)
  startDate       DateTime?
  endDate         DateTime?
  packagingDate   DateTime?
  cargoReadyDate  DateTime?
  status          ProductionPlanStatus @default(Draft)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization  Organization  @relation(fields: [orgId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  facility      Facility      @relation(fields: [facilityId], references: [id])

  @@index([orgId])
  @@index([purchaseOrderId])
}

enum InventoryType {
  RawMaterial
  WIP
  FinishedGoods
  PackagingMaterial
}

enum InventoryStatus {
  Expected
  Received
  Quarantine
  Accepted
  Conditional
  Rejected
  Reserved
  InProduction
  Consumed
  Expired
}

model Inventory {
  id                String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId             String          @db.Uuid
  productId         String          @db.Uuid
  batchId           String?         @db.Uuid
  lotId             String?         @db.Uuid
  inventoryType     InventoryType
  quantity          Decimal         @db.Decimal(14, 3)
  unit              String?
  location          String?
  status            InventoryStatus @default(Expected)
  reservedForDealId String?         @db.Uuid
  expiryDate        DateTime?
  unitCost          Decimal?        @db.Decimal(14, 4)
  currency          String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization          Organization           @relation(fields: [orgId], references: [id])
  product               Product                @relation(fields: [productId], references: [id])
  batch                 Batch?                 @relation(fields: [batchId], references: [id])
  lot                   Lot?                   @relation(fields: [lotId], references: [id])
  reservedForDeal       Deal?                  @relation(fields: [reservedForDealId], references: [id])
  batchRawMaterialLines BatchRawMaterialLine[]

  @@index([orgId])
  @@index([productId])
  @@index([batchId])
}

enum NCRType {
  RawMaterialDefect
  SpecificationFailure
