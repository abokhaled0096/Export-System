/// approvalId اتشال من الفورم — nullable، بلا واجهة، مفيش قيد مالي صريح ⚠️ في الـERD يستدعي تدفّق
/// موافقة استثنائية هنا (عكس walkAwayPrice).
model NegotiationRound {
  id                    String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                 String                     @db.Uuid
  negotiationId         String                     @db.Uuid
  roundNumber           Int
  roundDate             DateTime?
  customerOffer         Decimal?                   @db.Decimal(14, 4)
  ourOffer              Decimal?                   @db.Decimal(14, 4)
  discountPct           Decimal?                   @db.Decimal(5, 2)
  concessionType        NegotiationConcessionType?
  concessionValue       Decimal?                   @db.Decimal(14, 2)
  considerationObtained String?
  considerationValue    Decimal?                   @db.Decimal(14, 2)
  approvalId            String?                    @db.Uuid
  outcome               String?
  createdAt             DateTime                   @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  negotiation  Negotiation  @relation(fields: [negotiationId], references: [id])
  approval     Approval?    @relation(fields: [approvalId], references: [id])

  @@index([orgId])
  @@index([negotiationId])
