  updatedAt DateTime @updatedAt

  users                    User[]
  products                 Product[]
  markets                  Market[]
  companies                Company[]
  roles                    Role[]
  departments              Department[]
  teams                    Team[]
  exchangeRates            ExchangeRate[]
  approvalPolicies         ApprovalPolicy[]
  approvals                Approval[]
  deals                    Deal[]
  complianceCases          ComplianceCase[]
  requirements             Requirement[]
  gates                    Gate[]
  hsClassifications        HSClassification[]
  certificates             Certificate[]
  registrations            Registration[]
  originProofs             OriginProof[]
  rejectionCases           RejectionCase[]
  lcRequirements           LCRequirement[]
  shipments                Shipment[]
  shipmentParties          ShipmentParty[]
  bookings                 Booking[]
  containers               Container[]
  milestones               Milestone[]
  shipmentEvents           ShipmentEvent[]
  logisticsExceptions      LogisticsException[]
  freeTimeRecords          FreeTimeRecord[]
  actualLogisticsCosts     ActualLogisticsCost[]
  temperatureLogs          TemperatureLog[]
  transportTrips           TransportTrip[]
  claims                   Claim[]
  serviceProviders         ServiceProvider[]
  routes                   Route[]
  freightQuotes            FreightQuote[]
  freightQuoteLines        FreightQuoteLine[]
  suppliers                Supplier[]
  facilities               Facility[]
  sourcingRequests         SourcingRequest[]
  supplierQuotes           SupplierQuote[]
  purchaseOrders           PurchaseOrder[]
  batches                  Batch[]
  inspections              Inspection[]
  qualityReleases          QualityRelease[]
  lots                     Lot[]
  shipmentLots             ShipmentLot[]
  productionPlans          ProductionPlan[]
  inventories              Inventory[]
  ncrs                     NCR[]
  labTests                 LabTest[]
  farms                    Farm[]
  batchRawMaterialLines    BatchRawMaterialLine[]
  supplierRFQs             SupplierRFQ[]
  batchMarketEligibilities BatchMarketEligibility[]
  supplierAudits           SupplierAudit[]
  supplyContracts          SupplyContract[]
  packagingMaterials       PackagingMaterial[]
  supplierSamples          SupplierSample[]
  cargoReadinesses         CargoReadiness[]
  supplierPerformances     SupplierPerformance[]
  productSpecifications    ProductSpecification[]
  documents                Document[]
  capas                    CAPA[]
  documentVersions         DocumentVersion[]
  templates                Template[]
  documentPackages         DocumentPackage[]
  clauses                  Clause[]
  communications           Communication[]
  rfqAnalyses              RFQAnalysis[]
  customerSamples          CustomerSample[]
  negotiations             Negotiation[]
  negotiationRounds        NegotiationRound[]
  redFlags                 RedFlag[]
  leadAssignmentRules      LeadAssignmentRule[]
  salesTargets             SalesTarget[]
  commissionPlans          CommissionPlan[]
  commissionEntries        CommissionEntry[]
  customerServiceCases     CustomerServiceCase[]
  chartOfAccounts          ChartOfAccount[]
  accountingPeriods        AccountingPeriod[]
  journalEntries           JournalEntry[]
  journalLines             JournalLine[]
