// ============ وحدة 4 — المستندات والمواصفات: الشريحة الثانية ============

enum DocumentType {
  Quotation
  ProformaInvoice
  CommercialInvoice
  PackingList
  SalesContract
  SalesConfirmation
  TechnicalDataSheet
  COA
  Declaration
  PriceList
  EmailDraft
}

enum DocumentLanguage {
  Arabic
  English
  Bilingual
}

enum DocumentStatus {
  Draft
  Incomplete
  UnderReview
  RevisionRequired
  Approved
  Issued
  Sent
  Acknowledged
  Superseded
  Expired
  Cancelled
}

enum DocumentEtaStatus {
  NotApplicable
  Pending
  Submitted
  Validated
  Rejected
}

/// packageId→DocumentPackage وtemplateId→Template اتشالوا وقت البناء (الكيانين كانوا غير مبنيين)؛
/// اتقفلوا فعليًا كـ`DocumentPackage`/`Template` مستقلين (1 سبتمبر) بلا ربط مباشر بـDocument نفسه
/// (DocumentPackage مرتبطة بـDeal، Template كيان مشترك مستقل — راجع STATUS.md).
/// companyId/shipmentId/specificationId/approvalId اتحطوا كأعمدة nullable بلا واجهة اختيار في
/// الفورم (الكيانات موجودة فعليًا، بس مفيش داعي فورم اختيار لكل واحد دلوقتي — نفس نمط
/// NCR.batchId/lotId). content/fileUrl بلا واجهة إدخال (Supabase Storage/Signed URL لسه مش
/// مبنية في المشروع خالص). Trigger enforce_document_eta_validated (migration الـRLS بتاعة
/// الشريحة دي) بيمنع status→Issued/Sent لـdocumentType=CommercialInvoice بلا etaStatus=Validated
/// — نفس فلسفة enforce_gate_aci_deadline_met بالحرف (حقل يدوي، بلا تكامل حقيقي مع بوابة ETA).
model Document {
  id                String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId             String            @db.Uuid
  dealId            String            @db.Uuid
  companyId         String?           @db.Uuid
  shipmentId        String?           @db.Uuid
  specificationId   String?           @db.Uuid
  documentType      DocumentType
  documentNumber    String            @unique
  version           Int               @default(1)
  language          DocumentLanguage  @default(Arabic)
  status            DocumentStatus    @default(Draft)
  content           Json?
  fileUrl           String?
  confidentiality   String?
  completenessScore Decimal?          @db.Decimal(5, 2)
  approvalId        String?           @db.Uuid
  etaUuid           String?
  etaStatus         DocumentEtaStatus @default(NotApplicable)
  etaSubmittedAt    DateTime?
  expiryDate        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization    Organization          @relation(fields: [orgId], references: [id])
  deal            Deal                  @relation(fields: [dealId], references: [id])
  company         Company?              @relation(fields: [companyId], references: [id])
  shipment        Shipment?             @relation(fields: [shipmentId], references: [id])
  specification   ProductSpecification? @relation(fields: [specificationId], references: [id])
  approval        Approval?             @relation(fields: [approvalId], references: [id])
  supplyContracts SupplyContract[]
  versions        DocumentVersion[]
  invoices        Invoice[]

  @@index([orgId])
  @@index([dealId])
}

// ============ وحدة 4 (تابع) — إقفال أخير: DocumentVersion, Template, DocumentPackage, Clause ============
// راجع docs/SCOPE-P4.md § الشريحة الأخيرة و docs/ERD.md §7 للتفاصيل الكاملة.

/// سجل تاريخي لتعديلات Document. changedFields/previousValues/newValues/contentSnapshot (jsonb)
/// وapprovalId/supersededById اتشالوا من الفورم (nullable، بلا واجهة إدخال — نفس نمط
/// Document.content/approvalId). createdBy بيتحدَّد تلقائيًا بالمستخدم الحالي وقت الإنشاء
/// (نفس نمط CAPA.ownerId).
model DocumentVersion {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId           String   @db.Uuid
  documentId      String   @db.Uuid
  versionNumber   Int
  changeReason    String?
  changedFields   Json?
  previousValues  Json?
  newValues       Json?
  contentSnapshot Json?
  createdBy       String   @db.Uuid
  approvalId      String?  @db.Uuid
  supersededById  String?  @db.Uuid
  createdAt       DateTime @default(now())

  organization Organization      @relation(fields: [orgId], references: [id])
  document     Document          @relation(fields: [documentId], references: [id])
  creator      User              @relation(fields: [createdBy], references: [id])
  approval     Approval?         @relation(fields: [approvalId], references: [id])
  supersededBy DocumentVersion?  @relation("DocumentVersionSupersedes", fields: [supersededById], references: [id])
  supersedes   DocumentVersion[] @relation("DocumentVersionSupersedes")

  @@index([orgId])
  @@index([documentId])
}

enum TemplateStatus {
  Draft
  Approved
  Archived
}

/// كيان مشترك مستقل (زي CAPA) — بلا مالك طبيعي واحد. bodySchema (jsonb) اتشال من الفورم
/// (نفس نمط Document.content). usageCount بلا آلية تتبّع فعلية (مفيش تدفّق "توليد مستند من قالب"
/// لسه) — بيفضل 0 افتراضيًا.
model Template {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String           @db.Uuid
  documentType DocumentType
  language     DocumentLanguage @default(Arabic)
  marketId     String?          @db.Uuid
  customerId   String?          @db.Uuid
  bodySchema   Json?
  version      Int              @default(1)
  status       TemplateStatus   @default(Draft)
  usageCount   Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  market       Market?      @relation(fields: [marketId], references: [id])
  customer     Company?     @relation(fields: [customerId], references: [id])

  @@index([orgId])
}

enum DocumentPackageType {
  QuotationPack
  FirstOrderPack
  ShipmentPack
  SamplePack
  TenderPack
}

/// status enum قرار تفسيري (الـERD مش بيحدد قيم صراحةً)، نفس روح FacilityStatus.
