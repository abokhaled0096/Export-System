  Stalled
  Agreed
  Failed
}

/// supplierId/sourcingRequestId (وحدة 7 — تفاوض الموردين) اتشالوا من الفورم — nullable، بلا واجهة
/// اختيار، استخدام وحدة 7 خارج نطاق الشريحة دي، نفس نمط Document.shipmentId.
model Negotiation {
  id                String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId             String            @db.Uuid
  dealId            String?           @db.Uuid
  opportunityId     String?           @db.Uuid
  supplierId        String?           @db.Uuid
  sourcingRequestId String?           @db.Uuid
  status            NegotiationStatus @default(Open)
  currentPrice      Decimal?          @db.Decimal(14, 4)
  currency          String?           @db.Char(3)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization Organization       @relation(fields: [orgId], references: [id])
  deal         Deal?              @relation(fields: [dealId], references: [id])
  opportunity  Opportunity?       @relation(fields: [opportunityId], references: [id])
  rounds       NegotiationRound[]

  @@index([orgId])
  @@index([dealId])
  @@index([opportunityId])
}

