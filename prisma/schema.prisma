/// physicalParams/chemicalParams/microbiologicalParams/packagingSpec/labelSpec (jsonb) و
/// approvedBy بلا واجهة إدخال — نفس معاملة Farm.pesticideProgram/CargoReadiness.handoverPayload
/// (مفيش فورم بسيط مناسب لبيانات jsonb حرة، هيتضافوا لو ظهر احتياج فعلي).
model ProductSpecification {
  id                    String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                 String                     @db.Uuid
  productId             String                     @db.Uuid
  version               Int                        @default(1)
  status                ProductSpecificationStatus @default(Draft)
  physicalParams        Json?
  chemicalParams        Json?
  microbiologicalParams Json?
