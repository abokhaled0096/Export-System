  orgId       String          @db.Uuid
  userId      String?         @db.Uuid
  teamId      String?         @db.Uuid
  period      String
  targetType  SalesTargetType
  targetValue Decimal         @db.Decimal(14, 2)
  currency    String?         @db.Char(3)
  actualValue Decimal?        @db.Decimal(14, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  team         Team?        @relation(fields: [teamId], references: [id])

  @@index([orgId])
}

enum CommissionBasis {
  RevenuePercent
  GrossProfitPercent
  Tiered
  CollectionBased
}

enum CommissionTriggerEvent {
  OnWon
  OnInvoice
  OnCollection
}

/// tiers (jsonb) اتشال من الفورم — نفس نمط باقي حقول jsonb الحرة في المشروع.
model CommissionPlan {
  id           String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String                 @db.Uuid
  name         String
  basis        CommissionBasis
  ratePct      Decimal?               @db.Decimal(5, 2)
  tiers        Json?
  triggerEvent CommissionTriggerEvent
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id])
  entries      CommissionEntry[]

  @@index([orgId])
}

enum CommissionEntryStatus {
  Accrued
  Approved
  Paid
}

/// journalEntryId بقى FK حقيقي لـJournalEntry (وحدة 8 قفلت بالكامل 19/19 في 2 سبتمبر — كان
/// عمود UUID خام بلا علاقة قبل كده). userId مش تلقائي بالمستخدم الحالي — العمولة بتتسجّل
/// لموظف مبيعات تاني غالبًا، select من مستخدمي المنظمة. status=Paid مرفوض بلا journalEntryId
/// (Trigger enforce_commission_entry_paid) — الترحيل الفعلي عبر payCommissionEntryAction
/// (src/lib/accounting.ts: postCommissionPayment)، مش تغيير حالة مجرد.
model CommissionEntry {
  id             String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId          String                @db.Uuid
  planId         String                @db.Uuid
  dealId         String?               @db.Uuid
  salesOrderId   String?               @db.Uuid
  userId         String                @db.Uuid
  amount         Decimal               @db.Decimal(14, 2)
  currency       String?               @db.Char(3)
  status         CommissionEntryStatus @default(Accrued)
  journalEntryId String?               @db.Uuid
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization   @relation(fields: [orgId], references: [id])
  plan         CommissionPlan @relation(fields: [planId], references: [id])
  deal         Deal?          @relation(fields: [dealId], references: [id])
  salesOrder   SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  journalEntry JournalEntry?  @relation(fields: [journalEntryId], references: [id])

  @@index([orgId])
  @@index([dealId])
  @@index([planId])
}

enum CustomerServiceCaseType {
  Complaint
  Claim
  QualityIssue
  Shortage
  Damage
  LateShipment
  WrongDocumentation
}

enum CustomerServiceCaseStatus {
