  organization Organization @relation(fields: [orgId], references: [id])
  assignToUser User?        @relation("LeadAssignmentRuleAssignToUser", fields: [assignToUserId], references: [id])
  assignToTeam Team?        @relation(fields: [assignToTeamId], references: [id])

  @@index([orgId])
}

enum SalesTargetType {
  Revenue
  Volume
  DealsCount
}

/// period نص حر ("2026-Q3"/"سبتمبر 2026") — الـERD ما حددش صيغة. actualValue (⚙️) اتشال من الفورم
/// — بلا محرك تجميع فعلي من Deal/SalesOrder، نفس فلسفة "لا تُعطِ رقم محسوب بلا محرك حقيقي".
model SalesTarget {
