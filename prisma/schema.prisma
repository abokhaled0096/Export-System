// منظومة أبوهيبة للتصدير — Prisma schema
// نطاق P1 فقط (راجع ../docs/SCOPE-P1.md) — لا الـ92 كيان في ../docs/ERD.md دفعة واحدة.
// كل كيان هنا موثّق بنفس الاسم والحقول في ERD v3 §0 (الطبقة المشتركة) و§4 (وحدة 1) و§6 (وحدة 3).
//
// قواعد عامة (ERD v3 §1) مطبّقة هنا:
// - id: uuid بقيمة افتراضية uuidv7() (Postgres 18) — ما عدا User، راجع الملاحظة عليه تحت.
// - orgId على كل كيان تشغيلي — أساس كل RLS policy لاحقًا.
// - deletedAt nullable = أرشفة، لا حذف فعلي.
// - AuditLog: جدول Insert-only فعليًا — لا updatedAt ولا deletedAt هنا، والإنفاذ الفعلي
//   لمنع UPDATE/DELETE عليه لازم يتعمل بـ Migration خام (RLS Policy) بعد أول `prisma migrate dev`،
//   Prisma نفسه مايقدرش يعبّر عن "insert-only" كقيد schema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== الطبقة المشتركة (Platform) ====================

