  organization Organization @relation(fields: [orgId], references: [id])
  deal         Deal         @relation(fields: [dealId], references: [id])
  shipment     Shipment?    @relation(fields: [shipmentId], references: [id])

  @@index([orgId])
  @@index([dealId])
}

enum ClauseCategory {
  Payment
  Delivery
  Quality
  Claims
  ForceMajeure
  GoverningLaw
  Confidentiality
  Cancellation
}

/// قرار تفسيري (الـERD ما حددش قيم صراحةً)، نفس روح RejectionSeverity.
enum ClauseRiskLevel {
  Low
  Medium
  High
}

/// كيان مشترك مستقل (زي CAPA) — مكتبة بنود قانونية بلا مالك طبيعي واحد.
model Clause {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String          @db.Uuid
  title            String
  category         ClauseCategory
  textAr           String?
  textEn           String?
  riskLevel        ClauseRiskLevel @default(Low)
  approvalRequired Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

// ============ كيان مشترك (Shared Layer) — Corrective and Preventive Action ============

enum CAPARootCauseMethod {
  FiveWhys
  Fishbone
  Other
}

enum CAPAStatus {
  Open
  InProgress
  VerificationPending
  Effective
  Ineffective
  Closed
  Overdue
}

/// كيان مشترك (Shared Layer، مش تابع لوحدة واحدة) — docs/ERD.md §1.5 سطر 65. بيقفل دَين
/// NCR.capaId (وحدة 7) وRejectionCase.capaId (وحدة 5)، الاتنين كانوا متشالين لعدم وجود الكيان ده.
/// ownerId بيتحدَّد تلقائيًا بالمستخدم الحالي وقت الإنشاء (نفس نمط BatchMarketEligibility.assessedBy).
/// verifiedBy بلا واجهة إدخال (نفس معاملة ProductSpecification.approvedBy) — بلا تدفّق Verify/Close
/// في الشريحة دي (النطاق متسق مع إن NCR/RejectionCase نفسهم بلا أي UI تعديل بعد الإنشاء).
model CAPA {
  id               String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String               @db.Uuid
  rootCause        String?
  rootCauseMethod  CAPARootCauseMethod?
  correctiveAction String?
  preventiveAction String?
  ownerId          String               @db.Uuid
  dueDate          DateTime?
  verifiedBy       String?              @db.Uuid
  status           CAPAStatus           @default(Open)
  createdAt        DateTime             @default(now())

  organization         Organization          @relation(fields: [orgId], references: [id])
  ownerUser            User                  @relation("CAPAOwner", fields: [ownerId], references: [id])
  verifiedByUser       User?                 @relation("CAPAVerifiedBy", fields: [verifiedBy], references: [id])
  ncrs                 NCR[]
  rejectionCases       RejectionCase[]
  customerServiceCases CustomerServiceCase[]

  @@index([orgId])
}

// ==================== وحدة 8 — الحسابات والخزينة (🆕v4) — الشريحة الأولى: دفتر الأستاذ الأساسي ====================
// راجع docs/ERD.md §11.1 للتفاصيل الكاملة. أول شريحة من 4 — الأساس اللي كل كيان تاني في الوحدة
// (فواتير، خزينة، أصول) هيُبنى فوقه. بلا الشريحة دي مفيش نظام محاسبي حقيقي، بس تقديرات تسعير.
//
// ⚠️ Triggers إلزامية (docs/ERD.md §11.1):
// 1. enforce_journal_entry_balanced — SUM(JournalLine.debit) = SUM(JournalLine.credit) لكل
//    JournalEntry وقت ما status يتحول لـPosted، على مستوى القاعدة مش تحقق واجهة.
// 2. enforce_accounting_period_not_hard_closed — أي JournalLine جديد لفترة HardClosed يترفض.

enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  COGS
  Expense
}

enum NormalBalance {
  Debit
  Credit
}

/// شجرة حسابات (parentAccountId self-relation). accountCode بترقيم قياسي احترافي
/// (1000s أصول، 2000s خصوم، 3000s حقوق ملكية، 4000s إيرادات، 5000s تكلفة مبيعات، 6000s مصروفات)
/// — بيانات أساسية جاهزة في prisma/seed.ts، نفس فلسفة الأدوار التسعة الافتراضية.
model ChartOfAccount {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId           String        @db.Uuid
  accountCode     String
  nameAr          String
  nameEn          String
  accountType     AccountType
  parentAccountId String?       @db.Uuid
  normalBalance   NormalBalance
  currency        String?       @db.Char(3)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization  Organization     @relation(fields: [orgId], references: [id])
  parentAccount ChartOfAccount?  @relation("ChartOfAccountParent", fields: [parentAccountId], references: [id])
  childAccounts ChartOfAccount[] @relation("ChartOfAccountParent")
  journalLines  JournalLine[]

  @@unique([orgId, accountCode])
  @@index([orgId])
}

enum AccountingPeriodStatus {
  Open
  SoftClosed
  HardClosed
}

model AccountingPeriod {
  id         String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId      String                 @db.Uuid
  periodName String
  startDate  DateTime
  endDate    DateTime
  status     AccountingPeriodStatus @default(Open)
  closedBy   String?                @db.Uuid
  closedAt   DateTime?
  createdAt  DateTime               @default(now())

  organization   Organization   @relation(fields: [orgId], references: [id])
  closedByUser   User?          @relation("AccountingPeriodClosedBy", fields: [closedBy], references: [id])
  journalEntries JournalEntry[]
  budgets        Budget[]
  taxRecords     TaxRecord[]
  kpis           KPI[]

  @@unique([orgId, periodName])
  @@index([orgId])
}

enum JournalEntrySourceType {
  Manual
  Automatic
  Recurring
  Reversal
  Accrual
  Adjustment
}

enum JournalEntryStatus {
  Draft
  Posted
  Reversed
}

/// entryNumber بصيغة JE-{year}-{seq}، نفس نمط PurchaseOrder.poNumber (src/app/sourcing/actions.ts).
/// الترحيل (Draft→Posted) هو اللي بيفعّل Trigger enforce_journal_entry_balanced.
model JournalEntry {
  id           String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String                 @db.Uuid
  entryNumber  String
  entryDate    DateTime
  periodId     String                 @db.Uuid
  sourceType   JournalEntrySourceType @default(Manual)
  sourceModule String?
  description  String?
  status       JournalEntryStatus     @default(Draft)
  preparedBy   String                 @db.Uuid
  reviewedBy   String?                @db.Uuid
  approvedBy   String?                @db.Uuid
  reversalOfId String?                @db.Uuid
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  organization        Organization        @relation(fields: [orgId], references: [id])
  period              AccountingPeriod    @relation(fields: [periodId], references: [id])
  preparedByUser      User                @relation("JournalEntryPreparedBy", fields: [preparedBy], references: [id])
  reviewedByUser      User?               @relation("JournalEntryReviewedBy", fields: [reviewedBy], references: [id])
  approvedByUser      User?               @relation("JournalEntryApprovedBy", fields: [approvedBy], references: [id])
  reversalOf          JournalEntry?       @relation("JournalEntryReversal", fields: [reversalOfId], references: [id])
  reversals           JournalEntry[]      @relation("JournalEntryReversal")
  lines               JournalLine[]
  invoices            Invoice[]
  payments            Payment[]
  bankTransactions    BankTransaction[]
  loans               Loan[]
  loanInstallments    LoanInstallment[]
  depreciationEntries DepreciationEntry[]
  fixedAssetDisposals FixedAsset[]        @relation("FixedAssetDisposal")
  commissionEntries   CommissionEntry[]

  @@unique([orgId, entryNumber])
  @@index([orgId])
  @@index([periodId])
}

/// وسم الأبعاد (Dimension Tagging) — dealId/shipmentId/supplierId nullable، بلا واجهة اختيار في
/// الشريحة دي (هتُستخدم لما وحدات لاحقة تترحّل تلقائيًا عبر src/lib/accounting.ts). ده اللي بيخلي
/// "ربح الصفقة الحقيقي" محسوب من دفتر الأستاذ فعليًا مش تقدير DealScenario — docs/ERD.md §11 مقدمة.
model JournalLine {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId          String   @db.Uuid
  journalEntryId String   @db.Uuid
  accountId      String   @db.Uuid
  debit          Decimal  @default(0) @db.Decimal(14, 2)
  credit         Decimal  @default(0) @db.Decimal(14, 2)
  currency       String   @db.Char(3)
  fxRateId       String?  @db.Uuid
  costCenterId   String?  @db.Uuid
  profitCenterId String?  @db.Uuid
  dealId         String?  @db.Uuid
  shipmentId     String?  @db.Uuid
  supplierId     String?  @db.Uuid
  description    String?
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [orgId], references: [id])
  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id])
  account      ChartOfAccount @relation(fields: [accountId], references: [id])
  fxRate       ExchangeRate?  @relation(fields: [fxRateId], references: [id])
  costCenter   CostCenter?    @relation(fields: [costCenterId], references: [id])
  profitCenter ProfitCenter?  @relation(fields: [profitCenterId], references: [id])
  deal         Deal?          @relation(fields: [dealId], references: [id])
  shipment     Shipment?      @relation(fields: [shipmentId], references: [id])
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])

  @@index([orgId])
  @@index([journalEntryId])
  @@index([accountId])
}

enum CostCenterType {
  Department
  Product
  Customer
  Deal
  Market
}

model CostCenter {
  id        String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId     String         @db.Uuid
  code      String
  name      String
  type      CostCenterType
  createdAt DateTime       @default(now())

  organization Organization  @relation(fields: [orgId], references: [id])
  journalLines JournalLine[]
  budgets      Budget[]
  fixedAssets  FixedAsset[]

  @@unique([orgId, code])
  @@index([orgId])
}

enum ProfitCenterScope {
  Company
  Division
  Product
  Market
}

model ProfitCenter {
  id        String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId     String            @db.Uuid
  code      String
  name      String
  scope     ProfitCenterScope
  createdAt DateTime          @default(now())

  organization Organization  @relation(fields: [orgId], references: [id])
  journalLines JournalLine[]

  @@unique([orgId, code])
  @@index([orgId])
}

// ==================== وحدة 8 — الشريحة التانية: AR/AP (الفواتير والتحصيل والسداد) ====================
// راجع docs/ERD.md §11.2. الشريحة دي بتحوّل SalesOrder/PurchaseOrder الموجودين لقيود محاسبية حقيقية
// عبر محرك الترحيل (src/lib/accounting.ts) — أول استهلاك فعلي له من خارج الإدخال اليدوي.
//
// ⚠️ انحرافات واعية عن المواصفة (اتوثّقت في STATUS.md بعد مراجعة نقدية):
// 1. BankAccount اتسحب من الشريحة 3 — Payment.bankAccountId بلا الكيان ده مالوش معنى.
// 2. Payment.counterpartyType/counterpartyId (FK متعدد الأشكال بلا تكامل مرجعي) اتبدلوا بـ
//    companyId/supplierId nullable — نفس نمط Invoice في المواصفة نفسها (تناقض داخلي فيها).
// 3. Invoice.amountPaid عمود جديد بيتصان بـTrigger بس — المواصفة بتخزّن status مشتقّة يدويًا،
//    وده انحراف مضمون بين الحالة والواقع.
// 4. Invoice.status.Overdue مش بتتخزّن أبدًا — حالة زمنية بتتحسب وقت العرض من dueDate.
// 5. Payment.createdBy/approvedBy اتضافوا استباقًا لقاعدة فصل المهام (ERD سطر 418، وحدة 9).

/// 🔒 accountNumber/iban/swift مشفّرين عبر Supabase Vault (src/lib/vault.ts) — نفس نمط
/// Supplier.bankIBAN وTransportTrip.driverPhone. بلا واجهة إدخال لسه.
model BankAccount {
  id                    String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                 String   @db.Uuid
  accountName           String
  bankName              String
  currency              String   @db.Char(3)
  accountNumberSecretId String?  @db.Uuid
  ibanSecretId          String?  @db.Uuid
  swiftSecretId         String?  @db.Uuid
  openingBalance        Decimal  @default(0) @db.Decimal(14, 2)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization    Organization         @relation(fields: [orgId], references: [id])
  payments        Payment[]
  transactions    BankTransaction[]
  reconciliations BankReconciliation[]
  loans           Loan[]

  @@index([orgId])
}

enum InvoiceType {
  SalesInvoice
  PurchaseInvoice
  CreditNote
  DebitNote
  ProformaInvoice
}

/// Overdue موجودة لالتزام المواصفة بس — مبتتخزّنش أبدًا (حالة زمنية، بتتحسب وقت العرض من dueDate،
/// لأن أي حالة زمنية مخزَّنة بتبقى قديمة لحظة ما بتتكتب بلا حدث يحدّثها).
enum InvoiceStatus {
  Draft
  Issued
  PartiallyPaid
  Paid
  Overdue
  Disputed
  Cancelled
}

/// amountPaid بيتصان بـTrigger sync_invoice_payment_status بس — ممنوع أي كود يكتبه بإيد.
/// journalEntryId بيتملّى تلقائيًا وقت الإصدار (postInvoiceIssued في src/lib/accounting.ts).
/// documentId nullable: الفاتورة المسودة أو فاتورة المورّد ممكن تكون بلا مستند قانوني، لكن
/// ⚠️ Trigger enforce_invoice_eta_validated بيمنع إصدار فاتورة مبيعات بلا مستند ETA معتمد.
model Invoice {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId           String        @db.Uuid
  invoiceNumber   String
  invoiceType     InvoiceType
  dealId          String?       @db.Uuid
  salesOrderId    String?       @db.Uuid
  purchaseOrderId String?       @db.Uuid
  companyId       String?       @db.Uuid
  supplierId      String?       @db.Uuid
  documentId      String?       @db.Uuid
  currency        String        @db.Char(3)
  subtotal        Decimal       @db.Decimal(14, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal       @db.Decimal(14, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(14, 2)
  issueDate       DateTime
  dueDate         DateTime
  status          InvoiceStatus @default(Draft)
  journalEntryId  String?       @db.Uuid
  notes           String?
  idempotencyKey  String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization  Organization        @relation(fields: [orgId], references: [id])
  deal          Deal?               @relation(fields: [dealId], references: [id])
  salesOrder    SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  purchaseOrder PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  company       Company?            @relation(fields: [companyId], references: [id])
  supplier      Supplier?           @relation(fields: [supplierId], references: [id])
  document      Document?           @relation(fields: [documentId], references: [id])
  journalEntry  JournalEntry?       @relation(fields: [journalEntryId], references: [id])
  allocations   PaymentAllocation[]

  @@unique([orgId, invoiceNumber])
  @@unique([orgId, idempotencyKey])
  @@index([orgId])
  @@index([companyId])
  @@index([supplierId])
  @@index([status])
}

enum PaymentDirection {
  Inbound
  Outbound
}

enum PaymentMethod {
  BankTransfer
  Check
  Cash
  LC
  Card
}

enum PaymentStatus {
  Pending
  Cleared
  Bounced
  Reversed
}

/// counterpartyType/counterpartyId من المواصفة اتبدلوا بـcompanyId/supplierId — FK حقيقي بدل
/// معرّف متعدد الأشكال بلا تكامل مرجعي. createdBy/approvedBy استباقًا لفصل المهام (وحدة 9).
model Payment {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId          String           @db.Uuid
  paymentNumber  String
  direction      PaymentDirection
  companyId      String?          @db.Uuid
  supplierId     String?          @db.Uuid
  bankAccountId  String           @db.Uuid
  amount         Decimal          @db.Decimal(14, 2)
  currency       String           @db.Char(3)
  fxRateId       String?          @db.Uuid
  paymentMethod  PaymentMethod    @default(BankTransfer)
  paymentDate    DateTime
  reference      String?
  status         PaymentStatus    @default(Pending)
  journalEntryId String?          @db.Uuid
  createdBy      String           @db.Uuid
  approvedBy     String?          @db.Uuid
  idempotencyKey String?          @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization     Organization        @relation(fields: [orgId], references: [id])
  company          Company?            @relation(fields: [companyId], references: [id])
  supplier         Supplier?           @relation(fields: [supplierId], references: [id])
  bankAccount      BankAccount         @relation(fields: [bankAccountId], references: [id])
  fxRate           ExchangeRate?       @relation(fields: [fxRateId], references: [id])
  journalEntry     JournalEntry?       @relation(fields: [journalEntryId], references: [id])
  createdByUser    User                @relation("PaymentCreatedBy", fields: [createdBy], references: [id])
  approvedByUser   User?               @relation("PaymentApprovedBy", fields: [approvedBy], references: [id])
  allocations      PaymentAllocation[]
  bankTransactions BankTransaction[]
  loanInstallments LoanInstallment[]
  taxRecords       TaxRecord[]

  @@unique([orgId, paymentNumber])
  @@unique([orgId, idempotencyKey])
  @@index([orgId])
  @@index([status])
}

/// جدول وسيط (نفس نمط ShipmentLot/BatchRawMaterialLine) — دفعة واحدة على عدة فواتير أو العكس.
/// ⚠️ Triggers بتمنع: التخصيص الزائد (فوق مبلغ الفاتورة أو الدفعة)، والتخصيص عابر العملات.
model PaymentAllocation {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId           String   @db.Uuid
  paymentId       String   @db.Uuid
  invoiceId       String   @db.Uuid
  allocatedAmount Decimal  @db.Decimal(14, 2)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  payment      Payment      @relation(fields: [paymentId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([orgId])
  @@index([invoiceId])
}

// ==================== وحدة 8 — الشريحة التالتة: الخزينة والبنوك ====================

enum BankTransactionType {
  Deposit
  Withdrawal
  TransferIn
  TransferOut
  Charge
  Interest
}

enum ReconciliationStatus {
  InProgress
  Reconciled
  Discrepancy
}

enum LoanStatus {
  Active
  Settled
  Defaulted
}

enum LoanInstallmentStatus {
  Pending
  Paid
}

enum CashFlowCategory {
  OpeningCash
  CustomerCollections
  SupplierPayments
  Payroll
  Freight
  Customs
  Taxes
  LoanService
  Capex
  ClosingCash
}

/// حركة بنكية من كشف الحساب. `paymentId` هو العمود اللي بيخلّي المطابقة البنكية ممكنة أصلًا
/// (مش موجود في docs/ERD.md §11.3 — أهم علاج في الشريحة دي).
/// `amount` موجب دايمًا؛ الاتجاه بيتشتق من `transactionType` في مكان واحد (src/lib/treasuryLabels.ts).
model BankTransaction {
  id               String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String              @db.Uuid
  bankAccountId    String              @db.Uuid
  transactionDate  DateTime
  amount           Decimal             @db.Decimal(14, 2)
  currency         String              @db.Char(3)
  transactionType  BankTransactionType
  reference        String?
  description      String?
  paymentId        String?             @db.Uuid
  reconciliationId String?             @db.Uuid
  journalEntryId   String?             @db.Uuid
  idempotencyKey   String?             @db.Uuid
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization   Organization        @relation(fields: [orgId], references: [id])
  bankAccount    BankAccount         @relation(fields: [bankAccountId], references: [id])
  payment        Payment?            @relation(fields: [paymentId], references: [id])
  reconciliation BankReconciliation? @relation(fields: [reconciliationId], references: [id])
  journalEntry   JournalEntry?       @relation(fields: [journalEntryId], references: [id])

  @@unique([orgId, idempotencyKey])
  @@index([orgId])
  @@index([bankAccountId])
  @@index([reconciliationId])
  @@index([paymentId])
}

/// مطابقة بنكية. `bookBalance` عمود مصان بـTrigger بالكامل — ممنوع يتكتب من التطبيق
/// (انحراف واعٍ عن الـERD اللي بيحطه كحقل يدوي، نفس علاج Invoice.amountPaid).
model BankReconciliation {
  id               String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String               @db.Uuid
  bankAccountId    String               @db.Uuid
  statementDate    DateTime
  statementBalance Decimal              @db.Decimal(14, 2)
  bookBalance      Decimal              @default(0) @db.Decimal(14, 2)
  status           ReconciliationStatus @default(InProgress)
  notes            String?
  reconciledBy     String?              @db.Uuid
  reconciledAt     DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization     Organization      @relation(fields: [orgId], references: [id])
  bankAccount      BankAccount       @relation(fields: [bankAccountId], references: [id])
  reconciledByUser User?             @relation("ReconciliationReconciledBy", fields: [reconciledBy], references: [id])
  transactions     BankTransaction[]

  @@index([orgId])
  @@index([bankAccountId])
}

/// قرض. `bankAccountId` (القرض نزل فين) و`outstandingPrincipal` (أهم رقم في القرض) مش
/// موجودين في الـERD — اتضافوا هنا. `outstandingPrincipal` مصان بـTrigger.
model Loan {
  id                   String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                String     @db.Uuid
  lenderName           String
  bankAccountId        String     @db.Uuid
  principal            Decimal    @db.Decimal(14, 2)
  outstandingPrincipal Decimal    @default(0) @db.Decimal(14, 2)
  currency             String     @db.Char(3)
  interestRatePct      Decimal?   @db.Decimal(6, 3)
  startDate            DateTime
  maturityDate         DateTime
  collateral           String?
  status               LoanStatus @default(Active)
  disbursedAt          DateTime?
  journalEntryId       String?    @db.Uuid
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id])
  bankAccount  BankAccount       @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  installments LoanInstallment[]

  @@index([orgId])
  @@index([status])
}

/// قسط قرض. `Overdue` **مش قيمة مخزَّنة** — بتتحسب وقت العرض من `dueDate` (نفس علاج
/// Invoice.Overdue في الشريحة اللي فاتت). السداد بيحصل بـ`Payment` حقيقي، مش بتغيير حالة.
model LoanInstallment {
  id               String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId            String                @db.Uuid
  loanId           String                @db.Uuid
  dueDate          DateTime
  principalPortion Decimal               @db.Decimal(14, 2)
  interestPortion  Decimal               @default(0) @db.Decimal(14, 2)
  status           LoanInstallmentStatus @default(Pending)
  paymentId        String?               @db.Uuid
  journalEntryId   String?               @db.Uuid
  paidAt           DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organization Organization  @relation(fields: [orgId], references: [id])
  loan         Loan          @relation(fields: [loanId], references: [id])
  payment      Payment?      @relation(fields: [paymentId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([orgId])
  @@index([loanId])
}

/// سطر توقّع تدفّق نقدي (توقّع بس — مفيش `isActual`). الفعلي بيتحسب من الدفعات المحصّلة
/// وقت العرض؛ رقم "فعلي" مكتوب بإيد رقم مخترع. OpeningCash/ClosingCash ممنوعين كإدخال
/// يدوي بـTrigger — دول أرصدة محسوبة مش تدفّقات.
model CashFlowForecastLine {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId         String           @db.Uuid
  weekStartDate DateTime         @db.Date
  category      CashFlowCategory
  amount        Decimal          @db.Decimal(14, 2)
  currency      String           @db.Char(3)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, weekStartDate, category, currency])
  @@index([orgId])
}

// ==================== وحدة 8 — الشريحة الرابعة والأخيرة: الموازنات والأصول والضرائب ====================

enum BudgetType {
  Sales
  Purchase
  OPEX
  CAPEX
  Cash
}

enum FixedAssetCategory {
  Equipment
  Vehicle
  Furniture
  Building
  ComputerHardware
  Other
}

enum DepreciationMethod {
  StraightLine
  DecliningBalance
}

enum FixedAssetStatus {
  Active
  Disposed
  Impaired
}

enum TaxType {
  VATOutput
  VATInput
  WithholdingTax
  PayrollTax
}

enum TaxFilingStatus {
  NotFiled
  Filed
  Paid
}

/// بند موازنة. `periodId` FK حقيقي لـ`AccountingPeriod` (مش نص حر زي الـERD) — ده اللي بيخلّي
/// مقارنة "موازنة مقابل فعلي" ممكنة أصلًا عبر JOIN حقيقي مع JournalLine.
model Budget {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String     @db.Uuid
  periodId     String     @db.Uuid
  budgetType   BudgetType
  costCenterId String?    @db.Uuid
  amount       Decimal    @db.Decimal(14, 2)
  currency     String     @db.Char(3)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id])
  period       AccountingPeriod @relation(fields: [periodId], references: [id])
  costCenter   CostCenter?      @relation(fields: [costCenterId], references: [id])

  @@unique([orgId, periodId, budgetType, costCenterId, currency])
  @@index([orgId])
  @@index([periodId])
}

/// أصل ثابت. `accumulatedDepreciation`/`netBookValue` مصانين بـTrigger بالكامل — مش موجودين
/// في الـERD رغم إنهم أهم رقمين في الأصل. `costCenterId` جديد كمان (كل كيان تاني في الوحدة
/// بيتوسم بمركز تكلفة إلا الأصل الثابت).
model FixedAsset {
  id                      String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                   String             @db.Uuid
  assetCode               String
  nameAr                  String
  nameEn                  String
  category                FixedAssetCategory
  costCenterId            String?            @db.Uuid
  purchaseDate            DateTime
  purchaseValue           Decimal            @db.Decimal(14, 2)
  currency                String             @db.Char(3)
  usefulLifeMonths        Int
  depreciationMethod      DepreciationMethod @default(StraightLine)
  accumulatedDepreciation Decimal            @default(0) @db.Decimal(14, 2)
  netBookValue            Decimal            @default(0) @db.Decimal(14, 2)
  disposalDate            DateTime?
  disposalValue           Decimal?           @db.Decimal(14, 2)
  disposalJournalEntryId  String?            @db.Uuid
  status                  FixedAssetStatus   @default(Active)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  organization         Organization        @relation(fields: [orgId], references: [id])
  costCenter           CostCenter?         @relation(fields: [costCenterId], references: [id])
  disposalJournalEntry JournalEntry?       @relation("FixedAssetDisposal", fields: [disposalJournalEntryId], references: [id])
  depreciationEntries  DepreciationEntry[]

  @@unique([orgId, assetCode])
  @@index([orgId])
  @@index([costCenterId])
}

/// سطر إهلاك — `amount` بيتحسب بمعادلة القسط الثابت في src/lib/depreciation.ts، مش إدخال حر.
/// `journalEntryId` إلزامي (عكس الـERD اللي بيحطه nullable) — إهلاك بلا قيد يعني مصروف حقيقي
/// مبيوصلش للدفتر. period نص "YYYY-MM" بسيط، متّسق مع @@unique(assetId, period).
model DepreciationEntry {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId          String   @db.Uuid
  assetId        String   @db.Uuid
  period         String
  amount         Decimal  @db.Decimal(14, 2)
  journalEntryId String   @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  asset        FixedAsset   @relation(fields: [assetId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])

  @@unique([assetId, period])
  @@index([orgId])
}

/// سجل ضريبي. لضريبة القيمة المضافة، `amount` بيتحسب من رصيد حسابي 1040/2030 وقت الاعتماد
/// (src/app/accounting/finance-actions.ts) — مش يتكتب. `paymentId` (جديد) هو اللي بيخلّي
/// filingStatus=Paid حدث نقدي حقيقي مش مجرد تغيير حالة، نفس نمط LoanInstallment.paymentId.
model TaxRecord {
  id           String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String          @db.Uuid
  taxType      TaxType
  periodId     String          @db.Uuid
  amount       Decimal         @db.Decimal(14, 2)
  currency     String          @db.Char(3)
  filingStatus TaxFilingStatus @default(NotFiled)
  filingDate   DateTime?
  etaReference String?
  paymentId    String?         @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id])
  period       AccountingPeriod @relation(fields: [periodId], references: [id])
  payment      Payment?         @relation(fields: [paymentId], references: [id])

  @@unique([orgId, taxType, periodId])
  @@index([orgId])
  @@index([periodId])
}

// ==================== وحدة 9 — الشريحة التانية: الحوكمة والإدارة ====================

/// قاعدة فصل مهام. action1/action2 نص حر بصيغة "Resource.Action" (زي "Payment.Create"/
/// "Payment.Approve") — جدول قواعد قابل للتفعيل من الواجهة، مش قيد مكتوب في الكود.
/// ⚠️ مطبَّقة فعليًا على Payment.createdBy/approvedBy بس دلوقتي (Trigger
/// enforce_segregation_of_duty_payment) — المثال الحرفي في docs/ERD.md §12 (Supplier→Payment
/// عابر الكيانات) محتاج Supplier.createdBy غير موجود؛ مسجَّل في BACKLOG.md.
model SegregationOfDutyRule {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId               String   @db.Uuid
  action1             String
  action2             String
  mustBeDifferentUser Boolean  @default(true)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

/// سجل قرارات. decidedBy مش بالضرورة المستخدم الحالي — ممكن تسجيل قرار حد تاني.
model DecisionLogEntry {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId             String   @db.Uuid
  title             String
  decisionDate      DateTime
  decidedBy         String   @db.Uuid
  context           String?
  outcome           String?
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime @default(now())

  organization  Organization @relation(fields: [orgId], references: [id])
  decidedByUser User         @relation("DecisionLogDecidedBy", fields: [decidedBy], references: [id])

  @@index([orgId])
}

enum RiskStatus {
  Open
  Mitigated
  Closed
}

model RiskRegisterItem {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId           String     @db.Uuid
  title           String
  category        String
  probability     Int // 0-100، نفس نمط Opportunity.probabilityOfClose
  financialImpact Decimal    @db.Decimal(14, 2)
  currency        String     @db.Char(3)
  ownerId         String     @db.Uuid
  mitigation      String?
  status          RiskStatus @default(Open)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  owner        User         @relation("RiskRegisterItemOwner", fields: [ownerId], references: [id])

  @@index([orgId])
}

/// actualValue إدخال يدوي عمدًا — مفيش محرك BI عام يحسبه تلقائيًا لكل نوع KPI ممكن.
/// periodId FK حقيقي لـAccountingPeriod (بدل نص حر) — نفس إصلاح Budget.period في وحدة 8.
model KPI {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId       String   @db.Uuid
  name        String
  category    String
  ownerId     String   @db.Uuid
  targetValue Decimal  @db.Decimal(14, 2)
  actualValue Decimal? @db.Decimal(14, 2)
  periodId    String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id])
  owner        User             @relation("KPIOwner", fields: [ownerId], references: [id])
  period       AccountingPeriod @relation(fields: [periodId], references: [id])

  @@index([orgId])
  @@index([periodId])
}

/// إشعار شخصي. إنشاء يدوي بس في الشريحة دي — الربط التلقائي بأحداث تانية (رفض SoD، تجاوز
/// موازنة) بند مستقبلي موثّق في BACKLOG.md.
model Notification {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId             String    @db.Uuid
  userId            String    @db.Uuid
  notificationType  String
  title             String
  body              String?
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  createdAt         DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation("NotificationUser", fields: [userId], references: [id])

  @@index([orgId])
  @@index([userId])
}

enum MasterDataChangeStatus {
  Pending
  Approved
  Rejected
}

/// كيان تسجيل بس في الشريحة دي — مش بوابة فعلية قدام إنشاء Company/Supplier/BankAccount
/// (تغيير سلوك كبير في 3 وحدات موجودة، محتاج قرار نطاق منفصل). مسجَّل في BACKLOG.md.
model MasterDataChangeRequest {
  id              String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId           String                 @db.Uuid
  entityType      String
  entityId        String
  proposedChanges Json
  requestedBy     String                 @db.Uuid
  status          MasterDataChangeStatus @default(Pending)
  approvedBy      String?                @db.Uuid
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization    Organization @relation(fields: [orgId], references: [id])
  requestedByUser User         @relation("MasterDataChangeRequestedBy", fields: [requestedBy], references: [id])
  approvedByUser  User?        @relation("MasterDataChangeApprovedBy", fields: [approvedBy], references: [id])

  @@index([orgId])
}
