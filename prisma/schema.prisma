// ==================== الوحدة 2 — التسعير والقرار (شريحة أولى فقط، ERD v4 §5) ====================
// نطاق هذه الشريحة: Deal/DealScenario/CostItem/Quote بس — راجع docs/SCOPE-P2.md للتفاصيل
// والتأجيلات المقصودة (RiskItem, QuoteLine, SalesOrder*, DealActual، ومحرك الحساب التكراري).
// + 3 كيانات من الطبقة المشتركة لازمة كأساس: ExchangeRate, ApprovalPolicy, Approval.

enum ExchangeRateType {
  Spot
  Budget
  Contracted
  Actual
}

/// عملة الأساس مقابل عملة الاقتباس في تاريخ معيّن — DealScenario.fxRateId إلزامي (بلا افتراضي 1.0،
/// راجع CLAUDE.md §الأمان: "ممنوع تمامًا أي fxRateId يكون فاضي/افتراضي").
model ExchangeRate {
