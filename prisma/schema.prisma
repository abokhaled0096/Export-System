/// shipmentId اختياري بلا واجهة اختيار دلوقتي — نفس نمط Document.shipmentId بالحرف.
/// completenessScore بلا واجهة إدخال (عمود لمحرك حساب مستقبلي، نفس Document.completenessScore).
model DocumentPackage {
  id                String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId             String                @db.Uuid
