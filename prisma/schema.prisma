// ==================== الوحدة 9 — الحوكمة والإدارة (13/13 كيان، ERD v4 §12) ====================
// اكتملت بالكامل (7 سبتمبر) — آخر كيانين (FieldPermission, WorkflowDefinition) اتبنوا استباقيًا
// كبنية تحتية عامة بطلب صريح من المستخدم، بعد ما كانوا مؤجَّلين لغياب حالة استخدام تانية غير
// الحالة الوحيدة الموجودة وقتها. راجع STATUS.md/BACKLOG.md للتفاصيل الكاملة.

enum PermissionAction {
  View
  Create
  Edit
  Delete
  Approve
  Export
  /// استيراد بالجملة (CSV) — خطر مختلف عن Create لحركة واحدة، صلاحية مستقلة عمدًا. أول استخدام: BankTransaction.
  Import
}

enum PermissionScope {
  Own
  Team
  Org
}

/// أدوار قابلة للتخصيص بدل enum ثابت — الأدوار التسعة الأصلية بتتزرع كصفوف isSystemRole=true.
model Role {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String   @db.Uuid
  name         String
  description  String?
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization        Organization      @relation(fields: [orgId], references: [id])
  users               User[]
  rolePermissions     RolePermission[]
  fieldPermissions    FieldPermission[]
  requiredForPolicies ApprovalPolicy[]  @relation("ApprovalPolicyRequiredRole")

  @@unique([orgId, name])
  @@index([orgId])
}

/// كتالوج عالمي مشترك بين كل المنظمات — بلا orgId عن قصد (نفس "Quote" هو نفس المورد للجميع).
model Permission {
  id        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  resource  String // مثال "Opportunity", "Deal", "Quote"
  action    PermissionAction
  createdAt DateTime         @default(now())

  rolePermissions RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  roleId       String          @db.Uuid
  permissionId String          @db.Uuid
  scope        PermissionScope

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
}

enum FieldAccessLevel {
  Hidden
  ReadOnly
  ReadWrite
}

/// صلاحية عرض/تعديل على مستوى الحقل — طبقة تضييق إضافية فوق RolePermission (اللي بيتحكم في
/// الوصول للمورد كله)، مش بديل عنها. الغياب (مفيش صف) = ReadWrite افتراضيًا (بلا تقييد إضافي)،
/// عشان إضافة حقل جديد للنظام متطلبش تسجيل صف لكل دور موجود. أول استخدام حقيقي: إخفاء
/// walkAwayPrice/breakEvenPrice/expectedProfit/expectedMarginPct/expectedMarkupPct (DealScenario)
/// عن الأدوار بـOwn scope على Deal.View — كان بيتعمل بإعادة استخدام Deal.View scope كـproxy
/// (راجع BACKLOG.md، إعادة مراجعة وحدة 9، 7 سبتمبر).
model FieldPermission {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  roleId      String           @db.Uuid
  entityType  String
  fieldName   String
  accessLevel FieldAccessLevel
  createdAt   DateTime         @default(now())

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, entityType, fieldName])
  @@index([roleId])
}

/// خريطة انتقالات مسموحة لكل (entityType, fromStage) — بتحل محل خرائط TS ثابتة كانت متكررة
/// (OPPORTUNITY_STAGE_TRANSITIONS, CAPA_STATUS_TRANSITIONS)، وبتفتح قدرة جديدة: كل منظمة تقدر
/// تخصّص انتقالاتها من الواجهة بلا تعديل كود. requiredConditions (jsonb لشروط حرة، موثّق في
/// docs/ERD.md §12) مؤجَّل عمدًا — الشروط الحقيقية الوحيدة الموجودة (RFQAnalysis قبل QuoteSent،
/// verifiedBy قبل إقفال CAPA) مفروضة بالفعل بـTriggers مخصّصة على مستوى القاعدة
/// (enforce_opportunity_rfq_before_quote، enforce_capa_verification) ومش هتتلغى ولا هتتكرر هنا —
/// مفسّر شروط عام حقيقي هيتبنى لما تظهر حالة تانية محتاجاه فعليًا بدل تريجر مخصّص.
model WorkflowDefinition {
  id                       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId                    String   @db.Uuid
  entityType               String
  fromStage                String
  toStage                  String
  requiredApprovalPolicyId String?  @db.Uuid
  createdAt                DateTime @default(now())

  organization           Organization    @relation(fields: [orgId], references: [id])
  requiredApprovalPolicy ApprovalPolicy? @relation(fields: [requiredApprovalPolicyId], references: [id])

  @@unique([orgId, entityType, fromStage, toStage])
  @@index([orgId])
}

model Department {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId              String   @db.Uuid
  name               String
  parentDepartmentId String?  @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization     Organization @relation(fields: [orgId], references: [id])
  parentDepartment Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments   Department[] @relation("DepartmentHierarchy")
  teams            Team[]

  @@index([orgId])
}

model Team {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String   @db.Uuid
  name         String
  departmentId String   @db.Uuid
  managerId    String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization        Organization         @relation(fields: [orgId], references: [id])
  department          Department           @relation(fields: [departmentId], references: [id])
  manager             User?                @relation("TeamManager", fields: [managerId], references: [id])
  members             User[]               @relation("TeamMembers")
  leadAssignmentRules LeadAssignmentRule[]
  salesTargets        SalesTarget[]

  @@index([orgId])
}

/// ملاحظة: id هنا بدون @default(dbgenerated) عن قصد — لازم يساوي Supabase auth.users.id
/// وقت الإدخال (نفس الـuuid اللي Supabase Auth بيولّده)، مش uuidv7 مستقل. هذا الاستثناء
/// الوحيد لقاعدة uuidv7() في ERD v3 §1.1.
model User {
  id         String   @id @db.Uuid
  orgId      String   @db.Uuid
  fullName   String
  email      String   @unique
  roleId     String   @db.Uuid
  teamId     String?  @db.Uuid
  isActive   Boolean  @default(true)
  mfaEnabled Boolean  @default(false) // غير مُفعَّل إلزاميًا في P1 — يصير إلزاميًا مع أول عملية حساسة (P2+, راجع CLAUDE.md)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  team         Team?        @relation("TeamMembers", fields: [teamId], references: [id])

  opportunitiesOwned                Opportunity[]             @relation("OpportunityOwner")
  companiesOwned                    Company[]                 @relation("CompanyOwner")
  auditLogs                         AuditLog[]
  errorLogs                         ErrorLog[]
  gatesDecided                      Gate[]
  managedTeams                      Team[]                    @relation("TeamManager")
  approvalsRequested                Approval[]                @relation("ApprovalRequestedBy")
  approvalsDecided                  Approval[]                @relation("ApprovalDecidedBy")
  milestonesOwned                   Milestone[]               @relation("MilestoneOwner")
  shipmentEventsEntered             ShipmentEvent[]           @relation("ShipmentEventEnteredBy")
  qualityReleasesDone               QualityRelease[]          @relation("QualityReleaseReleasedBy")
  labTestsVerified                  LabTest[]                 @relation("LabTestVerifiedBy")
  batchMarketEligibilitiesAssessed  BatchMarketEligibility[]  @relation("BatchMarketEligibilityAssessedBy")
  inspections                       Inspection[]
  productSpecificationsApproved     ProductSpecification[]    @relation("ProductSpecificationApprovedBy")
  capasOwned                        CAPA[]                    @relation("CAPAOwner")
  capasVerified                     CAPA[]                    @relation("CAPAVerifiedBy")
  documentVersionsCreated           DocumentVersion[]
  redFlagsRaised                    RedFlag[]                 @relation("RedFlagRaisedBy")
  leadAssignmentRulesTarget         LeadAssignmentRule[]      @relation("LeadAssignmentRuleAssignToUser")
  salesTargets                      SalesTarget[]
  commissionEntries                 CommissionEntry[]
  customerServiceCasesOwned         CustomerServiceCase[]     @relation("CustomerServiceCaseOwner")
  accountingPeriodsClosed           AccountingPeriod[]        @relation("AccountingPeriodClosedBy")
  journalEntriesPrepared            JournalEntry[]            @relation("JournalEntryPreparedBy")
  journalEntriesReviewed            JournalEntry[]            @relation("JournalEntryReviewedBy")
  journalEntriesApproved            JournalEntry[]            @relation("JournalEntryApprovedBy")
  suppliersCreated                  Supplier[]                @relation("SupplierCreatedBy")
  quoteBundlesCreated               QuoteBundle[]
  paymentsCreated                   Payment[]                 @relation("PaymentCreatedBy")
  paymentsApproved                  Payment[]                 @relation("PaymentApprovedBy")
  reconciliationsReconciled         BankReconciliation[]      @relation("ReconciliationReconciledBy")
  decisionLogEntriesDecided         DecisionLogEntry[]        @relation("DecisionLogDecidedBy")
  riskRegisterItemsOwned            RiskRegisterItem[]        @relation("RiskRegisterItemOwner")
  kpisOwned                         KPI[]                     @relation("KPIOwner")
  notificationsReceived             Notification[]            @relation("NotificationUser")
  masterDataChangeRequestsRequested MasterDataChangeRequest[] @relation("MasterDataChangeRequestedBy")
  masterDataChangeRequestsApproved  MasterDataChangeRequest[] @relation("MasterDataChangeApprovedBy")

  @@index([orgId])
  @@index([roleId])
}

/// Insert-only فعليًا — منفصل ماديًا عن الجداول التشغيلية (ERD v3 §3).
/// ⚠️ منع UPDATE/DELETE عليه (حتى لـAdmin) لازم يُنفَّذ كـRLS Policy في Migration خام،
/// مش مجرد غياب دالة تعديل في الكود.
model AuditLog {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId       String   @db.Uuid
  userId      String?  @db.Uuid
  action      String // مثل "product.created", "opportunity.stage_changed"
  entityType  String
  entityId    String   @db.Uuid
  beforeValue Json?
  afterValue  Json?
  ipAddress   String?
  occurredAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([entityType, entityId])
}

/// Insert-only فعليًا (نفس نمط AuditLog) — سجل تشخيصي لأي استثناء غير متوقع بتبتلعه
/// `catch` blocks الحالية (كانت بترجع formError عام بلا أي أثر — راجع BACKLOG.md/STATUS.md
/// § متابعة الأخطاء 30 أغسطس). orgId/userId nullable لأن بعض الأخطاء بتحصل قبل ما نعرف
/// هوية المستخدم أصلًا (مثلًا session.ts requireCurrentUser() نفسه بيرمي). الكتابة بتتم عبر
/// src/lib/errorLog.ts (raw prisma، مش scoped-prisma — لازم تنجح حتى لو مفيش سياق RLS صالح).
model ErrorLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId      String?  @db.Uuid
  userId     String?  @db.Uuid
  action     String // اسم الـServer Action/route اللي فشلت، مثل "createDeal"
  message    String
  stack      String?
  occurredAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([occurredAt])
}

// ==================== الوحدة 1 — المنتج والسوق (ERD v3 §4) ====================

enum ProductStatus {
  Draft
  Verified
  NeedsReview
}

model Product {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId     String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // أرشفة، لا حذف

  nameAr                String
  nameEn                String
  hsCode                String
  category              String
  originCountry         String
  harvestSeason         String?
  availableMonths       Int[]
  storageTempC          Decimal?      @db.Decimal(5, 2)
  shelfLifeDays         Int?
  requiresRefrigeration Boolean       @default(false)
  status                ProductStatus @default(Draft)

  organization      Organization            @relation(fields: [orgId], references: [id])
  analyses          ProductMarketAnalysis[]
  competitors       Competitor[]
  opportunities     Opportunity[]
  deals             Deal[]
  salesOrderLines   SalesOrderLine[]
  complianceCases   ComplianceCase[]
  requirements      Requirement[]
  hsClassifications HSClassification[]
  certificates      Certificate[]
  registrations     Registration[]
  shipments         Shipment[]
  sourcingRequests  SourcingRequest[]
  inventories       Inventory[]
  supplierSamples   SupplierSample[]
  specifications    ProductSpecification[]
  customerSamples   CustomerSample[]

  @@index([orgId])
}

model Market {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId     String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  countryNameAr      String
  countryNameEn      String
  countryCode        String // ISO 3166
  continent          String
  currency           String    @db.Char(3) // ISO 4217
  mainPorts          String[]
  tradeAgreement     String?
  politicalRiskScore Int? // 0-100
  logisticsRiskScore Int? // 0-100
  lastReviewedAt     DateTime?

  organization             Organization             @relation(fields: [orgId], references: [id])
  analyses                 ProductMarketAnalysis[]
  competitors              Competitor[]
  opportunities            Opportunity[]
  deals                    Deal[]
  complianceCases          ComplianceCase[]
  requirements             Requirement[]
  hsClassifications        HSClassification[]
  sourcingRequests         SourcingRequest[]
  batchMarketEligibilities BatchMarketEligibility[]
  templates                Template[]

  @@index([orgId])
}

enum PmaRecommendation {
  Start
  Study
  Monitor
  Avoid
}

/// 27 أغسطس: مصدر التحليل — Manual (فورم يدوي، P1 الأصلي) أو AI (بحث حي فعلي عبر Claude + web_search).
enum AnalysisSource {
  Manual
  AI
}

model ProductMarketAnalysis {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId     String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  productId        String            @db.Uuid
  marketId         String            @db.Uuid
  year             Int
  opportunityScore Int // 0-100 — يدوي أو من AI حسب source
  riskScore        Int // 0-100
  confidenceLevel  Int? // 0-100
  recommendation   PmaRecommendation
  source           AnalysisSource    @default(Manual)
  /// نص تبرير Claude للدرجة — إلزامي فعليًا لتحاليل AI (قاعدة "لا تُعطِ درجة بلا سبب"، ERD §3).
  aiReasoning      String?
  /// [{title, url}] من نتائج web_search الفعلية اللي اعتمد عليها التحليل.
  aiSources        Json?

  product Product @relation(fields: [productId], references: [id])
  market  Market  @relation(fields: [marketId], references: [id])

  @@index([orgId])
  @@index([productId, marketId])
}

/// منافسين حقيقيين لمنتج/سوق (ERD §194) — بحث آلي بالذكاء الاصطناعي (Manual/AI زي
/// ProductMarketAnalysis بالحرف) بدل إدخال يدوي بحت، بناءً على طلب المستخدم (6 سبتمبر).
/// strengthMonths/weaknessMonths أرقام شهور (1-12) — شهور قوة/ضعف المنافس موسميًا، تتقارن
/// بـProduct.availableMonths عشان تحدد الفجوات/التداخلات الموسمية الحقيقية.
model Competitor {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId          String         @db.Uuid
  productId      String         @db.Uuid
  marketId       String         @db.Uuid
  countryName    String
  strengthMonths Int[]
  weaknessMonths Int[]
  priceRangeMin  Decimal?       @db.Decimal(14, 4)
  priceRangeMax  Decimal?       @db.Decimal(14, 4)
  currency       String         @db.Char(3)
  source         AnalysisSource @default(Manual)
  /// نص تبرير الذكاء الاصطناعي — إلزامي فعليًا لسجلات AI (نفس قاعدة ProductMarketAnalysis).
  aiReasoning    String?
  /// [{title, url}] من نتائج web_search الفعلية.
  aiSources      Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  product Product @relation(fields: [productId], references: [id])
  market  Market  @relation(fields: [marketId], references: [id])

  @@index([orgId])
  @@index([productId, marketId])
}

// ==================== الوحدة 3 — العملاء (نطاق P1 فقط، ERD v3 §6) ====================

enum CompanyStatus {
  Lead
  Suspect
  Prospect
  Qualified
  ActiveOpportunity
  Customer
  RepeatCustomer
  StrategicAccount
  Dormant
  Rejected
  Blacklisted
}

model Company {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId     String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  legalName      String
  tradeName      String?
  country        String
  city           String?
  classification String[] // Importer, Distributor, Wholesaler...
  status         CompanyStatus @default(Lead)
  ownerId        String?       @db.Uuid

  /// 🔒 مشفّر عموديًا عبر Supabase Vault (src/lib/vault.ts) — العمود بيخزّن secretId (UUID)
  /// مش القيمة نفسها، نفس نمط Document.fileUrl. بلا واجهة إدخال لسه (4 سبتمبر 2026).
  bankAccountNameSecretId String? @db.Uuid
  bankIBANSecretId        String? @db.Uuid
  bankSWIFTSecretId       String? @db.Uuid

  organization         Organization          @relation(fields: [orgId], references: [id])
  owner                User?                 @relation("CompanyOwner", fields: [ownerId], references: [id])
  contacts             Contact[]
  opportunities        Opportunity[]
  deals                Deal[]
  quotes               Quote[]               @relation("QuoteCustomer")
  quoteBundles         QuoteBundle[]
  salesOrders          SalesOrder[]          @relation("SalesOrderCustomer")
  certificates         Certificate[]
  shipmentParties      ShipmentParty[]
  documents            Document[]
  templates            Template[]
  communications       Communication[]
  redFlags             RedFlag[]
  customerServiceCases CustomerServiceCase[]
  invoices             Invoice[]
  payments             Payment[]

  @@index([orgId])
}

enum DecisionRole {
  DecisionMaker
  EconomicBuyer
  TechnicalEvaluator
  User
  Procurement
  Finance
  Quality
  Logistics
  Gatekeeper
  Influencer
  Champion
  Opponent
  Unknown
}

model Contact {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId     String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  companyId     String        @db.Uuid
  name          String
  title         String?
  email         String?
  /// 🔒 مشفّر عبر Supabase Vault (src/lib/vault.ts، بيانات شخصية حساسة، ERD v3 §1.4).
  phoneSecretId String?       @db.Uuid
  decisionRole  DecisionRole?

  /// PDPL — موافقة صريحة على معالجة بيانات الشخص ده (Contact هو "صاحب البيانات" الفعلي،
  /// مش Company اللي هو شخص اعتباري). بيتسجّل وقت الموظف بيدخل بيانات جهة الاتصال، مش موافقة
  /// ذاتية عبر النظام — لسه محتاج قناة فعلية (إيميل/توقيع) توثّق موافقة الشخص نفسه، راجع STATUS.md.
  consentGiven Boolean   @default(false)
  consentAt    DateTime?
  /// PDPL — محو حقيقي (Anonymization) لا حذف الصف كامل، عشان مايتكسرش تاريخ الفرص/الصفقات
  /// المرتبطة (referential integrity). لما يتحط، الحقول الشخصية (name/title/email/phoneSecretId)
  /// بتتمسح فعليًا (والـsecret الفعلي في Vault بيتمسح كمان — راجع eraseContactData) والصف
  /// بيفضل موجود بـid بس كمرجع تاريخي محايد.
  erasedAt     DateTime?

  company        Company         @relation(fields: [companyId], references: [id])
  opportunities  Opportunity[]
  communications Communication[]

  @@index([orgId])
  @@index([companyId])
}

enum OpportunityStage {
  NewLead
  Contacted
  Qualified
  QuoteSent
  Won
  Lost
}

model Opportunity {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId     String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  companyId          String           @db.Uuid
  contactId          String?          @db.Uuid
  productId          String           @db.Uuid
  marketId           String           @db.Uuid
  stage              OpportunityStage @default(NewLead)
  expectedValue      Decimal?         @db.Decimal(14, 2)
  currency           String?          @db.Char(3)
  probabilityOfClose Int? // 0-100
  expectedCloseDate  DateTime?
  ownerId            String?          @db.Uuid
  nextAction         String?
  nextActionDate     DateTime?

  // حقول تسليم أولية (ERD v3 §13) — تغذّي DealScenario وقت التحويل في P2.
  indicativeQuantity     Decimal? @db.Decimal(14, 3)
  indicativeIncoterm     String?
  indicativePaymentTerms String?

  company Company  @relation(fields: [companyId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  product Product  @relation(fields: [productId], references: [id])
  market  Market   @relation(fields: [marketId], references: [id])
  owner   User?    @relation("OpportunityOwner", fields: [ownerId], references: [id])
  deals   Deal[]

  communications  Communication[]
  rfqAnalyses     RFQAnalysis[]
  customerSamples CustomerSample[]
  negotiations    Negotiation[]

  @@index([orgId])
  @@index([companyId])
  @@index([stage])
}

// ==================== وحدة 3 (تابع) — شريحة أولى: Communication, RFQAnalysis, CustomerSample, ====================
// ====================                  Negotiation+NegotiationRound, RedFlag ====================
// راجع docs/ERD.md §6 و docs/SCOPE-P1.md §3 للتفاصيل الكاملة. بلا Trigger جديد — الـTrigger الوحيد
// المفروض في الـERD (منع قفز Opportunity.stage بلا RFQAnalysis) مؤجَّل عمدًا لحد ما يوجد UI فعلي
// لتغيير stage أصلًا (مفيش تدفّق تعديل stage دلوقتي، القيد مش قابل للانتهاك عمليًا). راجع BACKLOG.md.

enum CommunicationChannel {
  Email
  WhatsApp
  Phone
  VideoMeeting
  PhysicalMeeting
  LinkedIn
  WebsiteInquiry
  Exhibition
}

enum CommunicationDirection {
  Inbound
  Outbound
}

/// responseTimeHours (⚙️) بيتحسب في الـServer Action وقت الحفظ لو respondedAt موجود (نفس نمط
/// quantitySaleable/expectedProfit في docs/SCOPE-P2.md §4) — عمود عادي قابل للكتابة، مش Generated.
model Communication {
  id                String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId             String                 @db.Uuid
  companyId         String                 @db.Uuid
